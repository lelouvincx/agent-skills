#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"

if ! command -v rsync >/dev/null 2>&1; then
	echo "error: rsync is required to check the runtime projection" >&2
	exit 1
fi

tmp_home="$(mktemp -d)"
trap 'rm -rf "$tmp_home"' EXIT

mkdir -p "$tmp_home/.config/amp/github-thread-events/policies"
touch "$tmp_home/.config/amp/github-thread-events/policies/stale.json"

HOME="$tmp_home" \
	AMP_CONFIG_DIR="$tmp_home/.config/amp" \
	"$REPO_DIR/sync-skills.sh"

for path in \
	".config/amp/AGENTS.md" \
	".config/amp/settings.json" \
	".config/amp/github-thread-events/config.json" \
	".config/amp/github-thread-events/config.schema.json" \
	".config/amp/github-thread-events/policy-set.schema.json" \
	".config/amp/github-thread-events/policies/global.json" \
	".config/amp/github-thread-events/policies/projects/lelouvincx/agent-skills.json" \
	".config/amp/plugins" \
	".config/amp/docs" \
	".config/amp/mcp-servers/git-diff-server.mjs" \
	".config/amp/projects.yaml" \
	".config/amp/PROJECTS.md"; do
	if [ ! -e "$tmp_home/$path" ]; then
		echo "error: projection did not create $path" >&2
		exit 1
	fi
done

if ! diff -qr "$REPO_DIR/amp/github-thread-events" "$tmp_home/.config/amp/github-thread-events"; then
	echo "error: GitHub thread event projection differs from its source" >&2
	exit 1
fi

if [ -e "$tmp_home/.config/amp/github-thread-events/policies/stale.json" ]; then
	echo "error: projection did not delete a stale GitHub thread event file" >&2
	exit 1
fi

if find "$REPO_DIR/amp/github-thread-events" "$tmp_home/.config/amp/github-thread-events" -type f \( -name '*.sqlite' -o -name '*.sqlite3' \) | grep -q .; then
	echo "error: source or projection contains runtime SQLite state" >&2
	exit 1
fi

if [ -e "$tmp_home/.config/amp/state/github-thread-events.sqlite" ]; then
	echo "error: projection created runtime GitHub thread event state" >&2
	exit 1
fi

for skill in "$REPO_DIR"/skills/*/; do
	name="$(basename "$skill")"
	for target in ".agents/skills/$name" ".claude/skills/$name"; do
		if [ ! -L "$tmp_home/$target" ] || [ "$(readlink "$tmp_home/$target")" != "$skill" ]; then
			echo "error: projection did not link $target to $skill" >&2
			exit 1
		fi
	done
done

resolver="$tmp_home/.local/bin/project-resolve"
if [ ! -L "$resolver" ] || [ "$(readlink "$resolver")" != "$REPO_DIR/bin/project-resolve" ] || [ ! -x "$resolver" ]; then
	echo "error: projection did not create an executable project-resolve link" >&2
	exit 1
fi

echo "Projection check passed"
