#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"

if ! command -v rsync >/dev/null 2>&1; then
	echo "error: rsync is required to check the runtime projection" >&2
	exit 1
fi

tmp_home="$(mktemp -d)"
trap 'rm -rf "$tmp_home"' EXIT

mkdir -p "$tmp_home/.config/amp/github-thread-events/policies"
touch "$tmp_home/.config/amp/github-thread-events/policies/stale.json"
mkdir -p "$tmp_home/.config/amp/agent-secrets"
touch "$tmp_home/.config/amp/agent-secrets/stale.json"
mkdir -p "$tmp_home/.config/amp/agent-browser-lifecycle"
touch "$tmp_home/.config/amp/agent-browser-lifecycle/stale.json"
mkdir -p "$tmp_home/.config/amp/conventions"
touch "$tmp_home/.config/amp/conventions/stale.md"
mkdir -p "$tmp_home/.config/amp/state"
printf '%s\n' 'pre-existing runtime state' > "$tmp_home/.config/amp/state/github-thread-events.sqlite"

HOME="$tmp_home" \
	AMP_CONFIG_DIR="$tmp_home/.config/amp" \
	"$REPO_DIR/sync-skills.sh"

for path in \
	".config/amp/AGENTS.md" \
	".config/amp/settings.json" \
	".config/amp/agent-secrets/bundles.json" \
	".config/amp/agent-secrets/bundles.schema.json" \
	".config/amp/agent-secrets/github-identities.json" \
	".config/amp/agent-secrets/github-identities.schema.json" \
	".config/amp/agent-secrets/lib-agent.sh" \
	".config/amp/agent-browser-lifecycle/schema.json" \
	".config/amp/github-thread-events/config.json" \
	".config/amp/github-thread-events/config.schema.json" \
	".config/amp/github-thread-events/policy-set.schema.json" \
	".config/amp/github-thread-events/policies/global.json" \
	".config/amp/github-thread-events/policies/projects/lelouvincx/agent-skills.json" \
	".config/amp/plugins" \
	".config/amp/docs" \
	".config/amp/mcp-servers/git-diff-server.mjs" \
	".config/amp/projects.yaml" \
	".config/amp/PROJECTS.md"; do
	if [ ! -e "$tmp_home/$path" ]; then
		echo "error: projection did not create $path" >&2
		exit 1
	fi
done

conventions="$tmp_home/.config/amp/conventions"
if [ ! -d "$conventions" ] || [ -L "$conventions" ]; then
	echo "error: projection did not copy Amp conventions into an independent directory" >&2
	exit 1
fi

if ! diff -qr "$REPO_DIR/amp/conventions" "$conventions"; then
	echo "error: Amp convention projection differs from its source" >&2
	exit 1
fi

if [ -e "$conventions/stale.md" ]; then
	echo "error: projection did not delete a stale Amp convention file" >&2
	exit 1
fi

if ! diff -qr "$REPO_DIR/amp/agent-secrets" "$tmp_home/.config/amp/agent-secrets"; then
	echo "error: agent secret policy projection differs from its source" >&2
	exit 1
fi

if [ -e "$tmp_home/.config/amp/agent-secrets/stale.json" ]; then
	echo "error: projection did not delete a stale agent secret policy file" >&2
	exit 1
fi

if [ -e "$tmp_home/.credentials/agent-secrets" ] \
	|| [ -e "$tmp_home/.local/share/agent-secrets/op-service-account-token" ]; then
	echo "error: projection created local agent secret credentials" >&2
	exit 1
fi

if ! diff -qr "$REPO_DIR/amp/agent-browser-lifecycle" "$tmp_home/.config/amp/agent-browser-lifecycle"; then
	echo "error: agent browser lifecycle projection differs from its source" >&2
	exit 1
fi

if [ -e "$tmp_home/.config/amp/agent-browser-lifecycle/stale.json" ]; then
	echo "error: projection did not delete a stale agent browser lifecycle file" >&2
	exit 1
fi

if ! diff -qr "$REPO_DIR/amp/github-thread-events" "$tmp_home/.config/amp/github-thread-events"; then
	echo "error: GitHub thread event projection differs from its source" >&2
	exit 1
fi

if [ -e "$tmp_home/.config/amp/github-thread-events/policies/stale.json" ]; then
	echo "error: projection did not delete a stale GitHub thread event file" >&2
	exit 1
fi

if find "$REPO_DIR/amp/github-thread-events" "$tmp_home/.config/amp/github-thread-events" -type f \( -name '*.sqlite' -o -name '*.sqlite3' \) | grep -q .; then
	echo "error: source or projection contains runtime SQLite state" >&2
	exit 1
fi

if [ "$(cat "$tmp_home/.config/amp/state/github-thread-events.sqlite")" != "pre-existing runtime state" ]; then
	echo "error: projection changed runtime GitHub thread event state" >&2
	exit 1
fi

for skill in "$REPO_DIR"/skills/*/; do
	name="$(basename "$skill")"
	for target in ".agents/skills/$name" ".claude/skills/$name"; do
		if [ ! -L "$tmp_home/$target" ] || [ "$(readlink "$tmp_home/$target")" != "$skill" ]; then
			echo "error: projection did not link $target to $skill" >&2
			exit 1
		fi
	done
done

resolver="$tmp_home/.local/bin/project-resolve"
if [ ! -L "$resolver" ] || [ "$(readlink "$resolver")" != "$REPO_DIR/bin/project-resolve" ] || [ ! -x "$resolver" ]; then
	echo "error: projection did not create an executable project-resolve link" >&2
	exit 1
fi

agent_secrets="$tmp_home/.local/bin/agent-secrets"
if [ ! -L "$agent_secrets" ] || [ "$(readlink "$agent_secrets")" != "$REPO_DIR/bin/agent-secrets" ] || [ ! -x "$agent_secrets" ]; then
	echo "error: projection did not create an executable agent-secrets link" >&2
	exit 1
fi

smartclass_wrangler_dev="$tmp_home/.local/bin/smartclass-wrangler-dev"
if [ ! -L "$smartclass_wrangler_dev" ] || [ "$(readlink "$smartclass_wrangler_dev")" != "$REPO_DIR/bin/smartclass-wrangler-dev" ] || [ ! -x "$smartclass_wrangler_dev" ]; then
	echo "error: projection did not create an executable smartclass-wrangler-dev link" >&2
	exit 1
fi

amp_runner="$tmp_home/.local/bin/amp-runner"
if [ ! -L "$amp_runner" ] || [ "$(readlink "$amp_runner")" != "$REPO_DIR/bin/amp-runner" ] || [ ! -x "$amp_runner" ]; then
	echo "error: projection did not create an executable amp-runner link" >&2
	exit 1
fi

amp_runner_logs="$tmp_home/.local/bin/amp-runner-logs"
if [ ! -L "$amp_runner_logs" ] || [ "$(readlink "$amp_runner_logs")" != "$REPO_DIR/bin/amp-runner-logs" ] || [ ! -x "$amp_runner_logs" ]; then
	echo "error: projection did not create an executable amp-runner-logs link" >&2
	exit 1
fi

echo "Projection check passed"
