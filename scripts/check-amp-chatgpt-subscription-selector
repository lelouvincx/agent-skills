#!/usr/bin/env bash
set -euo pipefail

repo_root="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
tool="$repo_root/bin/amp-chatgpt-subscription-selector"
tmp="$(mktemp -d "$HOME/.check-amp-chatgpt-selector.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/bin" "$tmp/home" "$tmp/agents"

cat > "$tmp/bin/amp" <<'EOF'
#!/usr/bin/env bash
case "$3" in
show)
	id="$4"
	printf 'show %s\n' "$id" >> "$TEST_CALLS"
	case "${TEST_SHOW_MODE:-valid}" in
		empty) exit 0 ;;
		missing-active) printf '{"id":"%s"}\n' "$id"; exit 0 ;;
		conflicting) printf '{"active":true,"nested":{"active":false}}\n'; exit 0 ;;
		fail) exit 8 ;;
	 esac
	active=false
	[ -f "$TEST_ACTIVE" ] && [ "$(cat "$TEST_ACTIVE")" = "$id" ] && active=true
	name="$id-name"
	printf '{\n  "id": "%s",\n  "name": "%s",\n  "type": "model_provider_openai_chatgpt",\n  "active": %s\n}\n' "$id" "$name" "$active"
	;;
test)
	id="$4"
	printf 'test %s\n' "$id" >> "$TEST_CALLS"
	if [ -n "${TEST_HOLD:-}" ]; then
		: > "${TEST_ENTERED:?entered path required}"
		while [ -e "$TEST_HOLD" ]; do sleep 0.05; done
	fi
	quota="${TEST_QUOTA:?quota fixture required}"
	if [ "$id" = fallback-id ] && [ -n "${TEST_FALLBACK_QUOTA:-}" ]; then
		quota="$TEST_FALLBACK_QUOTA"
	fi
	printf '%s\n' "$quota"
	[ "${TEST_FAIL:-0}" = 0 ] || exit 9
	;;
activate)
	printf 'activate %s\n' "$4" >> "$TEST_CALLS"
	printf '%s\n' "$4" > "$TEST_ACTIVE"
	printf '%s\n' "$4" >> "$TEST_ACTIVATIONS"
	;;
*) exit 8 ;;
esac
EOF
cat > "$tmp/bin/launchctl" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$TEST_LAUNCHCTL_LOG"
case "$1" in
print)
	[ "${TEST_PRINT_FAIL:-0}" = 0 ] || { printf '%s\n' 'unexpected launchctl error' >&2; exit 7; }
	[ -f "$TEST_LOADED" ] || { printf '%s\n' 'Could not find service' >&2; exit 113; }
	printf '%s\n' "gui/501/com.ampcode.chatgpt-subscription-selector = {" '	state = not running' '}'
	;;
bootout)
	[ "${TEST_BOOTOUT_FAIL:-0}" = 0 ] || exit 8
	rm -f "$TEST_LOADED"
	;;
bootstrap)
	[ "${TEST_BOOTSTRAP_FAIL:-0}" = 0 ] || exit 9
	touch "$TEST_LOADED"
	;;
esac
EOF
cat > "$tmp/bin/plutil" <<'EOF'
#!/usr/bin/env bash
[ "${TEST_PLUTIL_FAIL:-0}" = 0 ]
EOF
cat > "$tmp/bin/lockf" <<'EOF'
#!/usr/bin/env python3
import fcntl
import sys

fd = int(sys.argv[-1])
try:
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    raise SystemExit(75)
EOF
chmod +x "$tmp/bin/"*

run_tool() {
	HOME="$tmp/home" TEST_ACTIVE="$tmp/active" TEST_ACTIVATIONS="$tmp/activations" \
	TEST_CALLS="$tmp/calls" TEST_LAUNCHCTL_LOG="$tmp/launchctl.log" TEST_LOADED="$tmp/loaded" \
	AMP_CHATGPT_SELECTOR_STATE_DIR="$tmp/state" AMP_CHATGPT_SELECTOR_LAUNCH_AGENTS_DIR="$tmp/agents" \
	AMP_CHATGPT_SELECTOR_AMP="$tmp/bin/amp" AMP_CHATGPT_SELECTOR_LAUNCHCTL="$tmp/bin/launchctl" \
	AMP_CHATGPT_SELECTOR_PLUTIL="$tmp/bin/plutil" AMP_CHATGPT_SELECTOR_LOCKF="$tmp/bin/lockf" "$tool" "$@"
}

primary=preferred-id
fallback=fallback-id
printf '%s\n' "$primary" > "$tmp/active"
: > "$tmp/activations"
: > "$tmp/calls"

if run_tool install --preferred "$primary" --fallback "$fallback" >/dev/null 2>&1; then exit 1; fi
if run_tool install --preferred "$primary" --fallback "$fallback" --interval 0 >/dev/null 2>&1; then exit 1; fi
if run_tool install --preferred "$primary" --fallback "$fallback" --interval nope >/dev/null 2>&1; then exit 1; fi
run_tool install --preferred "$primary" --fallback "$fallback" --interval 3600
plist="$tmp/agents/com.ampcode.chatgpt-subscription-selector.plist"
grep -Fq '<key>RunAtLoad</key>' "$plist"
grep -Fq '<true/>' "$plist"
grep -Fq '<integer>3600</integer>' "$plist"
grep -Fq '<key>HOME</key>' "$plist"
grep -Fq '<key>PATH</key>' "$plist"
grep -Fxq 'INTERVAL=3600' "$tmp/state/config"

# Failed lifecycle operations do not publish staged configuration or report success.
config_digest="$(shasum -a 256 "$tmp/state/config" | awk '{print $1}')"
plist_digest="$(shasum -a 256 "$plist" | awk '{print $1}')"
if TEST_PLUTIL_FAIL=1 run_tool install --preferred replacement-id --fallback "$fallback" --interval 3600 >/dev/null 2>&1; then exit 1; fi
[ "$(shasum -a 256 "$tmp/state/config" | awk '{print $1}')" = "$config_digest" ]
if TEST_BOOTOUT_FAIL=1 run_tool install --preferred replacement-id --fallback "$fallback" --interval 3600 >/dev/null 2>&1; then exit 1; fi
[ "$(shasum -a 256 "$tmp/state/config" | awk '{print $1}')" = "$config_digest" ]
[ "$(shasum -a 256 "$plist" | awk '{print $1}')" = "$plist_digest" ]
[ -f "$tmp/loaded" ]
if TEST_PRINT_FAIL=1 run_tool install --preferred replacement-id --fallback "$fallback" --interval 3600 >/dev/null 2>&1; then exit 1; fi
[ "$(shasum -a 256 "$tmp/state/config" | awk '{print $1}')" = "$config_digest" ]
[ "$(shasum -a 256 "$plist" | awk '{print $1}')" = "$plist_digest" ]
[ -f "$tmp/loaded" ]

# A failed bootstrap reports failure and leaves the new job unloaded.
if TEST_BOOTSTRAP_FAIL=1 run_tool install --preferred replacement-id --fallback "$fallback" --interval 3600 >/dev/null 2>&1; then exit 1; fi
[ ! -f "$tmp/loaded" ]
grep -Fxq 'PREFERRED=replacement-id' "$tmp/state/config"
run_tool install --preferred "$primary" --fallback "$fallback" --interval 1800 >/dev/null
grep -Fq '<integer>1800</integer>' "$plist"
grep -Fxq 'INTERVAL=1800' "$tmp/state/config"

# Status before the first check stays readable and does not dump launchctl output.
never_run_status="$(run_tool status)"
printf '%s\n' "$never_run_status" | grep -Fxq 'Preferred: preferred-id-name (preferred-id)'
printf '%s\n' "$never_run_status" | grep -Fxq 'Fallback: fallback-id-name (fallback-id)'
printf '%s\n' "$never_run_status" | grep -Fxq 'Interval: 30 minutes'
printf '%s\n' "$never_run_status" | grep -Fxq 'Background check: scheduled'
printf '%s\n' "$never_run_status" | grep -Fxq 'Last check: never'
printf '%s\n' "$never_run_status" | grep -Fxq 'Next check: awaiting first check'
printf '%s\n' "$never_run_status" | grep -Fxq 'Result: never run'
printf '%s\n' "$never_run_status" | grep -Fxq 'Selected: none'
printf '%s\n' "$never_run_status" | grep -Fxq 'Preferred remaining: 5-hour unknown, weekly unknown'
printf '%s\n' "$never_run_status" | grep -Fxq 'Fallback remaining: weekly unknown'
printf '%s\n' "$never_run_status" | grep -Fxq 'Reason: selector has not run yet'
if printf '%s\n' "$never_run_status" | grep -Fq 'gui/'; then exit 1; fi

# A plan with one explicitly disabled window uses its supported active window.
disabled_output="$(TEST_QUOTA=$'x-codex-primary-window-minutes: 10080\nx-codex-primary-used-percent: 96\nx-codex-secondary-window-minutes: 0\nx-codex-secondary-used-percent: 0' run_tool run)"
printf '%s\n' "$disabled_output" | grep -Fq 'preferred remaining: 5-hour unavailable, weekly 4%'
[ "$(cat "$tmp/active")" = "$fallback" ]
[ "$(wc -l < "$tmp/activations" | tr -d ' ')" = 1 ]
grep -Fxq 'five_hour_remaining=unavailable' "$tmp/state/last-run"
grep -Fxq 'weekly_remaining=4' "$tmp/state/last-run"

# Either window at the configured threshold selects the fallback.
TEST_FAIL=1 TEST_QUOTA=$'x-codex-primary-window-minutes: 300\nx-codex-primary-used-percent: 95\nx-codex-secondary-window-minutes: 10080\nx-codex-secondary-used-percent: 20' run_tool run
[ "$(cat "$tmp/active")" = "$fallback" ]
[ "$(wc -l < "$tmp/activations" | tr -d ' ')" = 1 ]
grep -Fxq 'five_hour_remaining=5' "$tmp/state/last-run"
grep -Fxq 'weekly_remaining=80' "$tmp/state/last-run"

# Header order does not matter and an already active selection is not reactivated.
TEST_QUOTA=$'x-codex-primary-window-minutes: 10080\nx-codex-primary-used-percent: 95\nx-codex-secondary-window-minutes: 300\nx-codex-secondary-used-percent: 40' run_tool run
[ "$(wc -l < "$tmp/activations" | tr -d ' ')" = 1 ]

# Both windows above the threshold select the preferred connection again.
TEST_QUOTA=$'x-codex-primary-window-minutes: 300\nx-codex-primary-used-percent: 94\nx-codex-secondary-window-minutes: 10080\nx-codex-secondary-used-percent: 94' run_tool run
[ "$(cat "$tmp/active")" = "$primary" ]
[ "$(wc -l < "$tmp/activations" | tr -d ' ')" = 2 ]

# A missing window preserves the active connection and records a failure.
if TEST_FAIL=1 TEST_QUOTA=$'x-codex-primary-window-minutes: 300\nx-codex-primary-used-percent: 99' run_tool run >/dev/null; then exit 1; fi
[ "$(cat "$tmp/active")" = "$primary" ]
grep -Fxq 'result=failed' "$tmp/state/last-run"
grep -Fxq 'detail=provider-test-failed' "$tmp/state/last-run"

# No supported active window preserves the active connection.
for quota in \
	$'x-codex-primary-window-minutes: 0\nx-codex-primary-used-percent: 0\nx-codex-secondary-window-minutes: 0\nx-codex-secondary-used-percent: 0' \
	$'x-codex-primary-window-minutes: 1440\nx-codex-primary-used-percent: 99\nx-codex-secondary-window-minutes: 0\nx-codex-secondary-used-percent: 0'; do
	before="$(wc -l < "$tmp/activations" | tr -d ' ')"
	if TEST_QUOTA="$quota" run_tool run >/dev/null; then exit 1; fi
	[ "$(wc -l < "$tmp/activations" | tr -d ' ')" = "$before" ]
	grep -Fxq 'detail=quota-windows-missing' "$tmp/state/last-run"
done

# Invalid percentages preserve the active connection.
for invalid in nope -1 101; do
	before="$(wc -l < "$tmp/activations" | tr -d ' ')"
	if TEST_QUOTA="x-codex-primary-window-minutes: 300
x-codex-primary-used-percent: $invalid
x-codex-secondary-window-minutes: 10080
x-codex-secondary-used-percent: 20" run_tool run >/dev/null; then exit 1; fi
	[ "$(wc -l < "$tmp/activations" | tr -d ' ')" = "$before" ]
	grep -Fxq 'detail=invalid-quota-percentage' "$tmp/state/last-run"
done

# Malformed or unavailable provider state never triggers activation.
valid_quota=$'x-codex-primary-window-minutes: 300\nx-codex-primary-used-percent: 95\nx-codex-secondary-window-minutes: 10080\nx-codex-secondary-used-percent: 20'
for mode in empty missing-active conflicting; do
	before="$(wc -l < "$tmp/activations" | tr -d ' ')"
	if TEST_SHOW_MODE="$mode" TEST_QUOTA="$valid_quota" run_tool run >/dev/null; then exit 1; fi
	[ "$(wc -l < "$tmp/activations" | tr -d ' ')" = "$before" ]
	grep -Fxq 'detail=invalid-selected-provider-state' "$tmp/state/last-run"
done
before="$(wc -l < "$tmp/activations" | tr -d ' ')"
if TEST_SHOW_MODE=fail TEST_QUOTA="$valid_quota" run_tool run >/dev/null; then exit 1; fi
[ "$(wc -l < "$tmp/activations" | tr -d ' ')" = "$before" ]
grep -Fxq 'detail=selected-provider-unavailable' "$tmp/state/last-run"

# The kernel lock prevents concurrent checks and installation, then releases after its owner exits.
touch "$tmp/hold"
TEST_HOLD="$tmp/hold" TEST_ENTERED="$tmp/entered" TEST_QUOTA="$valid_quota" run_tool run >/dev/null &
held_pid=$!
while [ ! -e "$tmp/entered" ]; do sleep 0.05; done
tests_before="$(grep -c '^test ' "$tmp/calls")"
TEST_QUOTA="$valid_quota" run_tool run >/dev/null
[ "$(grep -c '^test ' "$tmp/calls")" = "$tests_before" ]
locked_config_digest="$(shasum -a 256 "$tmp/state/config" | awk '{print $1}')"
if run_tool install --preferred replacement-id --fallback "$fallback" --interval 1800 >/dev/null 2>&1; then exit 1; fi
[ "$(shasum -a 256 "$tmp/state/config" | awk '{print $1}')" = "$locked_config_digest" ]
if run_tool pause >/dev/null 2>&1; then exit 1; fi
if run_tool resume >/dev/null 2>&1; then exit 1; fi
rm "$tmp/hold"
wait "$held_pid"
TEST_QUOTA="$valid_quota" run_tool run >/dev/null
[ "$(grep -c '^test ' "$tmp/calls")" = "$((tests_before + 3))" ]

# A terminated lock owner cannot leave a stale lock.
( exec 9>> "$tmp/state/selector.lock"; "$tmp/bin/lockf" -s -t 0 9; sleep 30 9>&- ) &
lock_pid=$!
sleep 0.1
kill "$lock_pid"
wait "$lock_pid" 2>/dev/null || true
tests_before="$(grep -c '^test ' "$tmp/calls")"
fallback_quota=$'x-codex-primary-window-minutes: 300\nx-codex-primary-used-percent: 12\nx-codex-secondary-window-minutes: 10080\nx-codex-secondary-used-percent: 30'
TEST_QUOTA="$valid_quota" TEST_FALLBACK_QUOTA="$fallback_quota" run_tool run >/dev/null
[ "$(grep -c '^test ' "$tmp/calls")" = "$((tests_before + 2))" ]
sed -i '' 's/^timestamp=.*/timestamp=2026-09-07T01:20:37Z/' "$tmp/state/last-run"

run_tool status > "$tmp/status.out"
grep -Fxq 'Preferred: preferred-id-name (preferred-id)' "$tmp/status.out"
grep -Fxq 'Fallback: fallback-id-name (fallback-id)' "$tmp/status.out"
grep -Fxq 'Threshold: 5% remaining' "$tmp/status.out"
grep -Fxq 'Interval: 30 minutes' "$tmp/status.out"
grep -Fxq 'Background check: scheduled' "$tmp/status.out"
grep -Fxq 'Last check: 2026-09-07 08:20:37 UTC+7' "$tmp/status.out"
grep -Fxq 'Next check: 2026-09-07 08:50:37 UTC+7' "$tmp/status.out"
grep -Fxq 'Result: ok' "$tmp/status.out"
grep -Fxq 'Selected: fallback-id-name (fallback-id)' "$tmp/status.out"
grep -Fxq 'Preferred remaining: 5-hour 5%, weekly 80%' "$tmp/status.out"
grep -Fxq 'Fallback remaining: weekly 70%' "$tmp/status.out"
grep -Fxq 'Reason: preferred subscription is at or below the remaining quota threshold' "$tmp/status.out"
if grep -Eq '^(timestamp|result|selected|five_hour_remaining|weekly_remaining|detail)=' "$tmp/status.out"; then exit 1; fi
if grep -Fq 'gui/' "$tmp/status.out"; then exit 1; fi

# Argument validation for pause and resume.
if run_tool pause extra >/dev/null 2>&1; then exit 1; fi
if run_tool resume extra >/dev/null 2>&1; then exit 1; fi

# Resuming when not paused fails.
if run_tool resume >/dev/null 2>&1; then exit 1; fi

# Failed pause preserves running state.
if TEST_BOOTOUT_FAIL=1 run_tool pause >/dev/null 2>&1; then exit 1; fi
[ -f "$tmp/loaded" ]
[ ! -f "$tmp/state/paused" ]

# Pause unloads the LaunchAgent and preserves the active subscription.
active_before_pause="$(cat "$tmp/active")"
run_tool pause | grep -Fq 'active subscription was unchanged'
[ ! -f "$tmp/loaded" ]
[ -f "$tmp/state/paused" ]
[ -f "$plist" ]
[ "$(cat "$tmp/active")" = "$active_before_pause" ]

# Pausing when already paused fails.
if run_tool pause >/dev/null 2>&1; then exit 1; fi

# Status reflects paused state.
run_tool status > "$tmp/status.paused.out"
grep -Fxq 'Background check: paused' "$tmp/status.paused.out"
grep -Fxq 'Interval: 30 minutes' "$tmp/status.paused.out"
grep -Fxq 'Next check: paused' "$tmp/status.paused.out"

# Run while paused fails and does not make quota or activation requests.
calls_before="$(wc -l < "$tmp/calls" | tr -d ' ')"
if run_tool run >/dev/null 2>&1; then exit 1; fi
[ "$(wc -l < "$tmp/calls" | tr -d ' ')" = "$calls_before" ]
[ "$(cat "$tmp/active")" = "$active_before_pause" ]

# Failed resume keeps the selector paused.
if TEST_BOOTSTRAP_FAIL=1 run_tool resume >/dev/null 2>&1; then exit 1; fi
[ ! -f "$tmp/loaded" ]
[ -f "$tmp/state/paused" ]

# Resume reloads the LaunchAgent and allows runs again.
run_tool resume | grep -Fq 'Resumed ChatGPT subscription selector'
[ -f "$tmp/loaded" ]
[ ! -f "$tmp/state/paused" ]
if run_tool resume >/dev/null 2>&1; then exit 1; fi
TEST_QUOTA="$valid_quota" run_tool run >/dev/null
[ "$(grep -c '^test ' "$tmp/calls")" = "$((tests_before + 4))" ]

# Reinstalling while paused clears the paused flag and loads the agent.
run_tool pause >/dev/null
[ -f "$tmp/state/paused" ]
run_tool install --preferred "$primary" --fallback "$fallback" --interval 1800 >/dev/null
[ ! -f "$tmp/state/paused" ]
[ -f "$tmp/loaded" ]

if TEST_BOOTOUT_FAIL=1 run_tool uninstall >/dev/null 2>&1; then exit 1; fi
[ -e "$plist" ] && [ -f "$tmp/loaded" ]
active_before_uninstall="$(cat "$tmp/active")"
run_tool uninstall | grep -Fq 'active subscription was unchanged'
[ ! -e "$plist" ]
[ "$(cat "$tmp/active")" = "$active_before_uninstall" ]

# Uninstalling while paused uninstalls cleanly and removes the paused flag.
run_tool install --preferred "$primary" --fallback "$fallback" --interval 1800 >/dev/null
run_tool pause >/dev/null
[ -f "$tmp/state/paused" ]
run_tool uninstall | grep -Fq 'active subscription was unchanged'
[ ! -e "$plist" ]
[ ! -f "$tmp/state/paused" ]

# Pause and resume fail when not installed.
if run_tool pause >/dev/null 2>&1; then exit 1; fi
if run_tool resume >/dev/null 2>&1; then exit 1; fi

printf '%s\n' 'Amp ChatGPT subscription selector contracts passed.'
