#!/usr/bin/env bash
set -euo pipefail

AGENT_SKILLS_REPO="${AGENT_SKILLS_REPO:-https://github.com/lelouvincx/agent-skills.git}"
AGENT_SKILLS_DIR="${AGENT_SKILLS_DIR:-/home/user/workspace/agent-skills}"

setup_source="$(cat "${BASH_SOURCE[0]}")"
export PATH="${HOME:-/home/user}/.local/bin:$PATH"

echo "[agent-skills] ensuring repository at $AGENT_SKILLS_DIR"

if [ ! -d "$AGENT_SKILLS_DIR/.git" ]; then
	rm -rf "$AGENT_SKILLS_DIR"
	git clone "$AGENT_SKILLS_REPO" "$AGENT_SKILLS_DIR"
else
	if git -C "$AGENT_SKILLS_DIR" diff --quiet && git -C "$AGENT_SKILLS_DIR" diff --cached --quiet; then
		git -C "$AGENT_SKILLS_DIR" pull --ff-only
	else
		echo "[agent-skills] local changes detected; skipping pull"
	fi
fi

# Pulling replaces files, not the setup body already running in this shell.
if [ "$setup_source" != "$(cat "$AGENT_SKILLS_DIR/.agents/setup")" ]; then
	echo "[agent-skills] restarting with the current setup"
	exec env AGENT_SKILLS_REPO="$AGENT_SKILLS_REPO" AGENT_SKILLS_DIR="$AGENT_SKILLS_DIR" \
		bash "$AGENT_SKILLS_DIR/.agents/setup" "$@"
fi

ensure_uv() {
	if command -v uv >/dev/null 2>&1 && command -v uvx >/dev/null 2>&1; then
		return 0
	fi

	echo "[agent-skills] uv/uvx missing; installing uv"
	if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
		if command -v apt-get >/dev/null 2>&1; then
			if [ "${EUID:-$(id -u)}" -eq 0 ]; then
				apt-get update
				DEBIAN_FRONTEND=noninteractive apt-get install -y curl ca-certificates
			elif command -v sudo >/dev/null 2>&1; then
				sudo apt-get update
				sudo DEBIAN_FRONTEND=noninteractive apt-get install -y curl ca-certificates
			fi
		fi
	fi

	if command -v curl >/dev/null 2>&1; then
		curl -LsSf https://astral.sh/uv/install.sh | sh
	elif command -v wget >/dev/null 2>&1; then
		wget -qO- https://astral.sh/uv/install.sh | sh
	else
		echo "[agent-skills] curl or wget is required to install uv" >&2
		return 1
	fi

	export PATH="${HOME:-/home/user}/.local/bin:$PATH"

	if ! command -v uv >/dev/null 2>&1 || ! command -v uvx >/dev/null 2>&1; then
		echo "[agent-skills] uv install did not add uv/uvx to PATH" >&2
		return 1
	fi
}

ensure_uv

ensure_op() {
	if command -v op >/dev/null 2>&1; then
		op --version
		return 0
	fi

	local elevate=()
	if [ "${EUID:-$(id -u)}" -ne 0 ]; then
		if ! command -v sudo >/dev/null 2>&1; then
			echo "[agent-skills] root or sudo is required to install 1Password CLI" >&2
			return 1
		fi
		elevate=(sudo -n)
	fi

	echo "[agent-skills] 1Password CLI missing; installing from its signed APT repository"
	"${elevate[@]}" apt-get update
	"${elevate[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends curl ca-certificates gnupg
	"${elevate[@]}" install -d /usr/share/keyrings /etc/apt/sources.list.d \
		/etc/debsig/policies/AC2D62742012EA22 /usr/share/debsig/keyrings/AC2D62742012EA22
	curl -fsSL https://downloads.1password.com/linux/keys/1password.asc | \
		"${elevate[@]}" gpg --batch --yes --dearmor --output /usr/share/keyrings/1password-archive-keyring.gpg
	printf 'deb [arch=%s signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/%s stable main\n' \
		"$(dpkg --print-architecture)" "$(dpkg --print-architecture)" | \
		"${elevate[@]}" tee /etc/apt/sources.list.d/1password.list >/dev/null
	curl -fsSL https://downloads.1password.com/linux/debian/debsig/1password.pol | \
		"${elevate[@]}" tee /etc/debsig/policies/AC2D62742012EA22/1password.pol >/dev/null
	"${elevate[@]}" cp /usr/share/keyrings/1password-archive-keyring.gpg \
		/usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg
	"${elevate[@]}" apt-get update
	"${elevate[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends 1password-cli
	op --version
}

ensure_op

# Amp-managed orbs may not include rsync by default. Install it when possible
# because sync-skills.sh uses rsync to project Amp plugins/docs into ~/.config/amp.
if ! command -v rsync >/dev/null 2>&1; then
	echo "[agent-skills] rsync missing; attempting to install it"
	if command -v apt-get >/dev/null 2>&1; then
		if [ "${EUID:-$(id -u)}" -eq 0 ]; then
			apt-get update
			DEBIAN_FRONTEND=noninteractive apt-get install -y rsync
		elif command -v sudo >/dev/null 2>&1; then
			sudo apt-get update
			sudo DEBIAN_FRONTEND=noninteractive apt-get install -y rsync
		fi
	fi
fi

# Last-resort fallback for locked-down orbs where package installation is not
# available. sync-skills.sh only needs this subset: rsync -a --delete
# <source-dir>/ <dest-dir>/ for Amp artifacts.
if ! command -v rsync >/dev/null 2>&1; then
	echo "[agent-skills] rsync install unavailable; using limited shell fallback"
	rsync() {
		local delete=false

		while [ "$#" -gt 0 ]; do
			case "$1" in
				-a|--archive)
					shift
					;;
				--delete)
					delete=true
					shift
					;;
				--*)
					echo "[agent-skills] unsupported rsync option in orb fallback: $1" >&2
					return 2
					;;
				-*)
					echo "[agent-skills] unsupported rsync option in orb fallback: $1" >&2
					return 2
					;;
				*)
					break
					;;
			esac
		done

		if [ "$#" -ne 2 ]; then
			echo "[agent-skills] orb rsync fallback expects source and destination" >&2
			return 2
		fi

		local src="$1"
		local dest="$2"

		mkdir -p "$dest"
		if [ "$delete" = true ]; then
			find "$dest" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
		fi
		cp -a "$src"/. "$dest"/
	}
	export -f rsync
fi

# Entire records Amp threads as checkpoints linked to commits. Install it in every
# orb, then wire hooks only into checkouts that commit .entire/settings.json.
ENTIRE_AGENT_AMP_VERSION="v0.0.0-20261020003721-23c64f2861dd"

ensure_entire() {
	local local_bin="${HOME:-/home/user}/.local/bin"

	if ! command -v entire >/dev/null 2>&1; then
		echo "[agent-skills] installing Entire CLI"
		curl -fsSL https://entire.com/install.sh | bash </dev/null
	fi

	if ! command -v entire-agent-amp >/dev/null 2>&1; then
		echo "[agent-skills] building entire-agent-amp $ENTIRE_AGENT_AMP_VERSION"
		local go_bin
		go_bin="$(command -v go || true)"
		if [ -z "$go_bin" ]; then
			local go_version
			go_version="$(curl -fsSL 'https://go.dev/VERSION?m=text' | head -1)"
			rm -rf "${HOME:-/home/user}/.local/go"
			curl -fsSL "https://go.dev/dl/${go_version}.linux-amd64.tar.gz" | tar -C "${HOME:-/home/user}/.local" -xz
			go_bin="${HOME:-/home/user}/.local/go/bin/go"
		fi
		GOBIN="$local_bin" "$go_bin" install \
			"github.com/entireio/external-agents/agents/entire-agent-amp/cmd/entire-agent-amp@$ENTIRE_AGENT_AMP_VERSION"
	fi

	local checkout
	for checkout in /home/user/workspace/repo /home/user/workspace/repos/*; do
		if git -C "$checkout" ls-files --error-unmatch .entire/settings.json >/dev/null 2>&1; then
			echo "[agent-skills] enabling Entire for Amp in $checkout"
			(cd "$checkout" && entire enable --agent amp --yes --local --telemetry=false </dev/null >/dev/null)
		fi
	done
}

ensure_entire || echo "[agent-skills] Entire setup failed; continuing without it" >&2

echo "[agent-skills] syncing default skills and Amp plugins"
"$AGENT_SKILLS_DIR/sync-skills.sh" --remote
