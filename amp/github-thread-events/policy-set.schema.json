{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lelouvincx/agent-skills/amp/github-thread-events/policy-set.schema.json",
  "title": "GitHub thread event policy set",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "policies"],
  "properties": {
    "formatVersion": {
      "const": "github-thread-event-policy-set/v1"
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceCandidate",
        "targetKind",
        "currentStatePreflight",
        "fixedAction",
        "sourcePointers",
        "actorTrust",
        "expiry"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
        },
        "sourceCandidate": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
        },
        "targetKind": {
          "const": "pull-request"
        },
        "currentStatePreflight": {
          "enum": [
            "failed-run-still-matches-current-head",
            "pull-request-still-merged-and-current",
            "current-unresolved-review-feedback",
            "pull-request-currently-conflicting"
          ]
        },
        "fixedAction": {
          "type": "string",
          "pattern": "\\S"
        },
        "sourcePointers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "delivery-id",
              "repository",
              "pull-request",
              "head-sha",
              "canonical-url",
              "actor"
            ]
          }
        },
        "actorTrust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instructionAuthority", "trustedActors"],
          "properties": {
            "instructionAuthority": {
              "const": "fixed-action-only"
            },
            "trustedActors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?$"
              }
            }
          }
        },
        "expiry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "const": "queue-retention"
            }
          }
        }
      }
    }
  }
}
