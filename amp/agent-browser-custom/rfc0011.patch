+async fn finish_credential_navigation_guard(
+    state: &DaemonState,
+    session_id: &str,
+    target_id: &str,
+    submitted: bool,
+    succeeded: bool,
+) {
+    if submitted && !succeeded {
+        if let Some(ref mgr) = state.browser {
+            let _ = mgr
+                .client
+                .send_command(
+                    "Target.closeTarget",
+                    Some(json!({ "targetId": target_id })),
+                    None,
+                )
+                .await;
+        }
+    }
+    *state.credential_navigation_guard.write().await = None;
+    if succeeded || !submitted {
+        let _ = refresh_fetch_interception(state, session_id).await;
+    }
+}
