+async fn wait_for_provider_login_state(
+    client: &CdpClient,
+    session_id: &str,
+    expected_url: &str,
+    marker_selector: &str,
+    marker_value: &str,
+    otp_selector: Option<&str>,
+    blocked: &AtomicU8,
+    timeout_ms: u64,
+) -> Result<&'static str, String> {
+    let deadline = tokio::time::Instant::now() + tokio::time::Duration::from_millis(timeout_ms);
+    let mut last_state = None;
+    let script = r#"function(expectedUrl, markerSelector, markerValue, otpSelector) {
+        let state = 'waiting';
+        let markerMatches = document.querySelectorAll(markerSelector);
+        let markerMatched = markerMatches.length === 1 && (markerMatches[0].textContent || '').includes(markerValue);
+        if (location.href === expectedUrl) {
+            if (markerMatched) state = 'authenticated';
+        }
+        const otpPresent = otpSelector !== null && location.origin === new URL(expectedUrl).origin && document.querySelector(otpSelector) !== null;
+        if (state === 'waiting' && otpPresent) {
+            state = 'otp';
+        }
+        return {
+            state,
+            origin: location.origin,
+            pathname: location.pathname,
+            expectedDestinationReached: location.href === expectedUrl,
+            markerCount: markerMatches.length,
+            markerMatched,
+            otpPresent,
+        };
+    }"#;
+    loop {
+        let blocked_reason = blocked.load(Ordering::SeqCst);
+        if blocked_reason != 0 {
+            let reason = match blocked_reason {
+                2 => "descendant interception setup",
+                _ => "unknown",
+            };
+            return Err(format!(
+                "Credential login was blocked to keep it on its approved origin: {reason}"
+            ));
+        }
+        if let Ok(result) = call_main_frame_function(
+            client,
+            session_id,
+            script,
+            vec![
+                Value::from(expected_url),
+                Value::from(marker_selector),
+                Value::from(marker_value),
+                otp_selector.map(Value::from).unwrap_or(Value::Null),
+            ],
+        )
+        .await
+        {
+            match result.get("state").and_then(Value::as_str) {
+                Some("authenticated") => return Ok("authenticated"),
+                Some("otp") => return Ok("otp"),
+                _ => last_state = Some(result),
+            }
+        }
+        if tokio::time::Instant::now() >= deadline {
+            let detail = last_state
+                .as_ref()
+                .map(|state| {
+                    format!(
+                        "observed={}{}; expectedDestinationReached={}; markerCount={}; markerMatched={}; otpPresent={}",
+                        state.get("origin").and_then(Value::as_str).unwrap_or("unknown"),
+                        state.get("pathname").and_then(Value::as_str).unwrap_or(""),
+                        state
+                            .get("expectedDestinationReached")
+                            .and_then(Value::as_bool)
+                            .unwrap_or(false),
+                        state.get("markerCount").and_then(Value::as_u64).unwrap_or(0),
+                        state
+                            .get("markerMatched")
+                            .and_then(Value::as_bool)
+                            .unwrap_or(false),
+                        state
+                            .get("otpPresent")
+                            .and_then(Value::as_bool)
+                            .unwrap_or(false),
+                    )
+                })
+                .unwrap_or_else(|| "page state unavailable".to_string());
+            return Err(format!(
+                "Login destination or account identity was not verified: {detail}"
+            ));
+        }
+        tokio::time::sleep(tokio::time::Duration::from_millis(
+            AUTH_LOGIN_SELECTOR_POLL_INTERVAL_MS,
+        ))
+        .await;
+    }
+}
+
+async fn close_and_confirm_credential_targets(
+    client: &CdpClient,
+    target_ids: &HashSet<String>,
+) -> Result<(), String> {
+    for target_id in target_ids {
+        let _ = client
+            .send_command(
+                "Target.closeTarget",
+                Some(json!({ "targetId": target_id })),
+                None,
+            )
+            .await;
+    }
+
+    let deadline = tokio::time::Instant::now() + tokio::time::Duration::from_secs(2);
+    loop {
+        if let Ok(result) = client
+            .send_command_no_params("Target.getTargets", None)
+            .await
+        {
+            if let Some(targets) = result.get("targetInfos").and_then(Value::as_array) {
+                let any_open = targets.iter().any(|target| {
+                    target
+                        .get("targetId")
+                        .and_then(Value::as_str)
+                        .is_some_and(|target_id| target_ids.contains(target_id))
+                });
+                if !any_open {
+                    return Ok(());
+                }
+            }
+        }
+        if tokio::time::Instant::now() >= deadline {
+            return Err(
+                "Could not confirm closure of the failed credential login target; network interception remains active"
+                    .to_string(),
+            );
+        }
+        tokio::time::sleep(tokio::time::Duration::from_millis(50)).await;
+    }
+}
+
+async fn finish_credential_navigation_guard(
+    state: &DaemonState,
+    succeeded: bool,
+) -> Result<(), String> {
+    let guard = state
+        .credential_navigation_guard
+        .read()
+        .await
+        .clone()
+        .ok_or("Credential navigation guard was unexpectedly absent")?;
+    let mgr = state.browser.as_ref().ok_or(
+        "Could not close credential login because the browser is unavailable; network interception remains active",
+    )?;
+
+    if !succeeded {
+        let target_ids = guard.target_ids.read().await.clone();
+        close_and_confirm_credential_targets(&mgr.client, &target_ids).await?;
+        *state.credential_navigation_guard.write().await = None;
+        return Ok(());
+    }
+
+    let session_ids = guard.fetch_session_ids.read().await.clone();
+    *state.credential_navigation_guard.write().await = None;
+    for session_id in session_ids {
+        if let Err(error) = refresh_fetch_interception(state, &session_id).await {
+            *state.credential_navigation_guard.write().await = Some(guard.clone());
+            let target_ids = guard.target_ids.read().await.clone();
+            close_and_confirm_credential_targets(&mgr.client, &target_ids).await?;
+            *state.credential_navigation_guard.write().await = None;
+            return Err(format!(
+                "Could not remove credential network interception: {error}; closed the login target"
+            ));
+        }
+    }
+    Ok(())
+}
