+async fn handle_managed_initialize(cmd: &Value, state: &mut DaemonState) -> Result<Value, String> {
+    if state.managed_initialized || state.browser.is_some() {
+        return Err("Managed browser is already initialized".to_string());
+    }
+    let expected = env::var("AGENT_BROWSER_MANAGED_CDP")
+        .map_err(|_| "AGENT_BROWSER_MANAGED_CDP is required in managed mode".to_string())?;
+    let requested = cmd
+        .get("cdpUrl")
+        .and_then(|value| value.as_str())
+        .ok_or("managed_initialize requires cdpUrl")?;
+    if requested != expected {
+        return Err("managed_initialize cdpUrl must match AGENT_BROWSER_MANAGED_CDP".to_string());
+    }
+
+    let launch_cmd = json!({
+        "id": cmd.get("id").cloned().unwrap_or_else(|| json!("managed-initialize")),
+        "action": "launch",
+        "cdpUrl": expected,
+    });
+    state.managed_initialized = true;
+    let result = handle_launch(&launch_cmd, state).await?;
+    Ok(result)
+}
+
+async fn handle_managed_shutdown(state: &mut DaemonState) -> Result<Value, String> {
+    if let Some(ref mgr) = state.browser {
