+    }
+    close_current_browser(state).await?;
+    Ok(json!({ "shutdown": true, "closed": true }))
+}
+
+async fn managed_preflight(cmd: &Value, action: &str, state: &mut DaemonState) -> Option<Value> {
+    if !state.managed {
+        return None;
+    }
+
+    let id = cmd.get("id").and_then(|v| v.as_str()).unwrap_or("");
+    match action {
+        "managed_status" => return Some(success_response(id, managed_status(state).await)),
+        "managed_initialize" => {
+            return Some(match handle_managed_initialize(cmd, state).await {
+                Ok(data) => success_response(id, data),
+                Err(err) => error_response(id, &err),
+            });
+        }
+        "managed_shutdown" => {
+            return Some(match handle_managed_shutdown(state).await {
+                Ok(data) => success_response(id, data),
+                Err(err) => error_response(id, &err),
+            });
+        }
+        _ => {}
+    }
+
+    if managed_restricted_action(action) {
+        return Some(error_response(
+            id,
+            &format!(
+                "Action '{}' is not supported in managed browser mode",
+                action
+            ),
+        ));
+    }
+    if action == "auth_login"
+        && cmd
+            .get("credentialProvider")
+            .and_then(|v| v.as_str())
+            .is_none()
+    {
+        return Some(error_response(
+            id,
+            "Managed browser mode supports auth_login only with an approved credential provider",
+        ));
+    }
+    if let Some(field) = managed_identity_changing_fields(cmd) {
+        return Some(error_response(
+            id,
+            &format!(
+                "Field '{}' is not supported in managed browser mode because browser identity is fixed by the lifecycle controller",
+                field
+            ),
+        ));
+    }
+    let Some(ref mut mgr) = state.browser else {
+        return Some(error_response(
+            id,
+            "Managed browser is not initialized; the lifecycle controller must call managed_initialize first",
+        ));
+    };
+    if mgr.has_process_exited() || !mgr.is_connection_alive().await {
+        return Some(error_response(
+            id,
+            "Managed browser connection is unavailable; refusing to auto-launch or reconnect",
+        ));
+    }
+    None
+}
