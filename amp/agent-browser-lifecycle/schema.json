{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lelouvincx/agent-skills/amp/agent-browser-lifecycle/schema.json",
  "title": "Agent Browser lifecycle records",
  "description": "Validates committed lifecycle.jsonl events and current.json materialized views.",
  "oneOf": [
    { "$ref": "#/$defs/lifecycleEventV1" },
    { "$ref": "#/$defs/lifecycleEventV2" },
    { "$ref": "#/$defs/currentStateV1" },
    { "$ref": "#/$defs/currentStateV2" }
  ],
  "$defs": {
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "sessionId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "threadId": { "type": "string", "pattern": "^T-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "absolutePath": { "type": "string", "pattern": "^/" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "daemonName": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "browserPid": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },
    "bootIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_uuid", "boot_time_us"],
      "properties": {
        "session_uuid": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "boot_time_us": { "type": "integer", "minimum": 1 }
      }
    },
    "birthIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boot", "pid", "start_time_us"],
      "properties": {
        "boot": { "$ref": "#/$defs/bootIdentity" },
        "pid": { "type": "integer", "minimum": 1 },
        "start_time_us": { "type": "integer", "minimum": 1 }
      }
    },
    "profileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "device", "inode"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "device": { "type": "integer", "minimum": 0 },
        "inode": { "type": "integer", "minimum": 1 }
      }
    },
    "lifecycleEventV1": {
      "$anchor": "lifecycleEvent",
      "title": "Committed Agent Browser lifecycle v1 event",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "timestamp", "event", "session_id", "owner_thread_id", "actor_thread_id", "cdp_host", "cdp_port", "user_data_dir", "browser_pid", "workspace"],
      "properties": {
        "schema": { "const": "agent-browser-lifecycle/v1" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "event": { "enum": ["claimed", "ready", "attached", "detached", "stopping", "start_failed", "stopped", "observed_dead"] },
        "session_id": { "$ref": "#/$defs/sessionId" },
        "owner_thread_id": { "$ref": "#/$defs/threadId" },
        "actor_thread_id": { "$ref": "#/$defs/threadId" },
        "cdp_host": { "const": "127.0.0.1" },
        "cdp_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "user_data_dir": { "$ref": "#/$defs/absolutePath" },
        "browser_pid": { "$ref": "#/$defs/browserPid" },
        "workspace": { "$ref": "#/$defs/absolutePath" }
      },
      "allOf": [
        { "if": { "properties": { "event": { "enum": ["claimed", "start_failed"] } }, "required": ["event"] }, "then": { "properties": { "browser_pid": { "type": "null" } } } },
        { "if": { "properties": { "event": { "enum": ["ready", "attached", "detached", "stopping", "stopped", "observed_dead"] } }, "required": ["event"] }, "then": { "properties": { "browser_pid": { "type": "integer", "minimum": 1 } } } }
      ]
    },
    "managedBaseEvent": {
      "type": "object",
      "required": ["schema", "timestamp", "event", "session_id", "generation", "owner_thread_id", "workspace", "namespace", "short_daemon_name", "runtime_path", "launch_mode", "cdp_host", "cdp_port", "user_data_dir", "build_digest", "config_digest"],
      "properties": {
        "schema": { "const": "agent-browser-lifecycle/v2" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "event": { "enum": ["managed_intent", "managed_profile_created", "managed_artifacts_recorded", "managed_role_identity", "managed_role_release", "managed_ready", "managed_attachment", "managed_detachment", "managed_draining", "managed_attachment_reconciled", "cleanup_pending", "managed_closed", "managed_artifacts_removed"] },
        "session_id": { "$ref": "#/$defs/sessionId" },
        "generation": { "type": "integer", "minimum": 1 },
        "owner_thread_id": { "$ref": "#/$defs/threadId" },
        "workspace": { "$ref": "#/$defs/absolutePath" },
        "namespace": { "$ref": "#/$defs/daemonName" },
        "short_daemon_name": { "$ref": "#/$defs/daemonName" },
        "runtime_path": { "$ref": "#/$defs/absolutePath" },
        "launch_mode": { "enum": ["headless", "headed"] },
        "cdp_host": { "const": "127.0.0.1" },
        "cdp_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "user_data_dir": { "$ref": "#/$defs/absolutePath" },
        "build_digest": { "$ref": "#/$defs/digest" },
        "config_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "lifecycleEventV2": {
      "$anchor": "managedLifecycleEvent",
      "oneOf": [
        { "allOf": [{ "$ref": "#/$defs/managedBaseEvent" }, { "properties": { "event": { "const": "managed_intent" } } }], "unevaluatedProperties": false },
        { "allOf": [{ "$ref": "#/$defs/managedBaseEvent" }, { "required": ["profile_identity"], "properties": { "event": { "const": "managed_profile_created" }, "profile_identity": { "$ref": "#/$defs/profileIdentity" } } }], "unevaluatedProperties": false },
        { "allOf": [{ "$ref": "#/$defs/managedBaseEvent" }, { "required": ["profile_identity", "runtime_identity", "artifact_boot"], "properties": { "event": { "const": "managed_artifacts_recorded" }, "profile_identity": { "$ref": "#/$defs/profileIdentity" }, "runtime_identity": { "$ref": "#/$defs/profileIdentity" }, "artifact_boot": { "$ref": "#/$defs/bootIdentity" } } }], "unevaluatedProperties": false },
        { "allOf": [{ "$ref": "#/$defs/managedBaseEvent" }, { "required": ["role", "birth_identity"], "properties": { "event": { "const": "managed_role_identity" }, "role": { "enum": ["chrome", "daemon"] }, "birth_identity": { "$ref": "#/$defs/birthIdentity" } } }], "unevaluatedProperties": false },
        { "allOf": [{ "$ref": "#/$defs/managedBaseEvent" }, { "required": ["role"], "properties": { "event": { "const": "managed_role_release" }, "role": { "enum": ["chrome", "daemon"] } } }], "unevaluatedProperties": false },
        { "allOf": [{ "$ref": "#/$defs/managedBaseEvent" }, { "required": ["chrome_pid", "daemon_pid", "daemon_build_id"], "properties": { "event": { "const": "managed_ready" }, "chrome_pid": { "type": "integer", "minimum": 1 }, "daemon_pid": { "type": "integer", "minimum": 1 }, "daemon_build_id": { "type": "string", "minLength": 1 } } }], "unevaluatedProperties": false },
        { "allOf": [{ "$ref": "#/$defs/managedBaseEvent" }, { "required": ["actor_thread_id"], "properties": { "event": { "const": "managed_attachment" }, "actor_thread_id": { "$ref": "#/$defs/threadId" } } }], "unevaluatedProperties": false },
        { "allOf": [{ "$ref": "#/$defs/managedBaseEvent" }, { "required": ["actor_thread_id"], "properties": { "event": { "const": "managed_detachment" }, "actor_thread_id": { "$ref": "#/$defs/threadId" } } }], "unevaluatedProperties": false },
        { "allOf": [{ "$ref": "#/$defs/managedBaseEvent" }, { "required": ["actor_thread_id"], "properties": { "event": { "const": "managed_draining" }, "actor_thread_id": { "$ref": "#/$defs/threadId" } } }], "unevaluatedProperties": false },
        { "allOf": [{ "$ref": "#/$defs/managedBaseEvent" }, { "required": ["actor_thread_id", "reconciled_thread_id"], "properties": { "event": { "const": "managed_attachment_reconciled" }, "actor_thread_id": { "$ref": "#/$defs/threadId" }, "reconciled_thread_id": { "$ref": "#/$defs/threadId" } } }], "unevaluatedProperties": false },
        { "allOf": [{ "$ref": "#/$defs/managedBaseEvent" }, { "required": ["reason"], "properties": { "event": { "const": "cleanup_pending" }, "reason": { "type": "string", "minLength": 1, "maxLength": 200 } } }], "unevaluatedProperties": false },
        { "allOf": [{ "$ref": "#/$defs/managedBaseEvent" }, { "properties": { "event": { "const": "managed_closed" } } }], "unevaluatedProperties": false },
        { "allOf": [{ "$ref": "#/$defs/managedBaseEvent" }, { "properties": { "event": { "const": "managed_artifacts_removed" } } }], "unevaluatedProperties": false }
      ]
    },
    "currentSessionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "state", "owner_thread_id", "cdp_host", "cdp_port", "user_data_dir", "browser_pid", "workspace", "attached_thread_ids", "last_event_at"],
      "properties": {
        "schema": { "const": "agent-browser-current/v1" },
        "verification": { "const": "legacy-unverified" },
        "session_id": { "$ref": "#/$defs/sessionId" },
        "state": { "enum": ["claimed", "ready", "stopping"] },
        "owner_thread_id": { "$ref": "#/$defs/threadId" },
        "cdp_host": { "const": "127.0.0.1" },
        "cdp_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "user_data_dir": { "$ref": "#/$defs/absolutePath" },
        "browser_pid": { "$ref": "#/$defs/browserPid" },
        "workspace": { "$ref": "#/$defs/absolutePath" },
        "attached_thread_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/threadId" } },
        "last_event_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "claimed" } } }, "then": { "properties": { "browser_pid": { "type": "null" }, "attached_thread_ids": { "maxItems": 0 } } } },
        { "if": { "properties": { "state": { "enum": ["ready", "stopping"] } } }, "then": { "properties": { "browser_pid": { "type": "integer", "minimum": 1 } } } },
        { "if": { "properties": { "state": { "const": "stopping" } } }, "then": { "properties": { "attached_thread_ids": { "maxItems": 0 } } } }
      ]
    },
    "managedRoleState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["birth_identity", "released"],
      "properties": {
        "birth_identity": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/birthIdentity" }] },
        "released": { "type": "boolean" }
      },
      "if": { "properties": { "released": { "const": true } } },
      "then": { "properties": { "birth_identity": { "$ref": "#/$defs/birthIdentity" } } }
    },
    "currentSessionV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "session_id", "generation", "state", "verification", "owner_thread_id", "workspace", "namespace", "short_daemon_name", "runtime_path", "launch_mode", "cdp_host", "cdp_port", "user_data_dir", "profile_identity", "runtime_identity", "artifact_boot", "build_digest", "config_digest", "roles", "attached_thread_ids", "chrome_pid", "daemon_pid", "daemon_build_id", "cleanup_pending_reason", "last_event_at"],
      "properties": {
        "schema": { "const": "agent-browser-current/v2" },
        "session_id": { "$ref": "#/$defs/sessionId" },
        "generation": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["intent-recorded", "profile-created", "artifacts-recorded", "chrome-identity-recorded", "chrome-released", "daemon-identity-recorded", "daemon-released", "ready", "draining", "cleanup-pending"] },
        "verification": { "enum": ["managed-unverified", "managed-ready"] },
        "owner_thread_id": { "$ref": "#/$defs/threadId" },
        "workspace": { "$ref": "#/$defs/absolutePath" },
        "namespace": { "$ref": "#/$defs/daemonName" },
        "short_daemon_name": { "$ref": "#/$defs/daemonName" },
        "runtime_path": { "$ref": "#/$defs/absolutePath" },
        "launch_mode": { "enum": ["headless", "headed"] },
        "cdp_host": { "const": "127.0.0.1" },
        "cdp_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "user_data_dir": { "$ref": "#/$defs/absolutePath" },
        "profile_identity": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/profileIdentity" }] },
        "runtime_identity": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/profileIdentity" }] },
        "artifact_boot": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/bootIdentity" }] },
        "build_digest": { "$ref": "#/$defs/digest" },
        "config_digest": { "$ref": "#/$defs/digest" },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chrome", "daemon"],
          "properties": { "chrome": { "$ref": "#/$defs/managedRoleState" }, "daemon": { "$ref": "#/$defs/managedRoleState" } }
        },
        "attached_thread_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/threadId" } },
        "chrome_pid": { "$ref": "#/$defs/browserPid" },
        "daemon_pid": { "$ref": "#/$defs/browserPid" },
        "daemon_build_id": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
        "cleanup_pending_reason": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 200 }] },
        "last_event_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "currentStateV1": {
      "$anchor": "currentState",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "generated_at", "sessions"],
      "properties": {
        "schema": { "const": "agent-browser-current/v1" },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "sessions": { "type": "array", "items": { "$ref": "#/$defs/currentSessionV1" } }
      }
    },
    "currentStateV2": {
      "$anchor": "managedCurrentState",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "generated_at", "sessions"],
      "properties": {
        "schema": { "const": "agent-browser-current/v2" },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "sessions": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/currentSessionV1" }, { "$ref": "#/$defs/currentSessionV2" }] } }
      }
    }
  }
}
