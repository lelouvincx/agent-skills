          "passwordVariable": "HOLISTICS_DEMO4_PASSWORD",
          "loginUrl": "https://demo4.holistics.io/users/sign_in",
          "credentialOrigin": "https://demo4.holistics.io",
          "usernameSelector": "#user_email",
          "passwordSelector": "#user_password",
          "submitSelector": "input[name=\"commit\"]",
          "otpVariable": "HOLISTICS_DEMO4_OTP",
          "otpSelector": "input[name=\"otp\"]",
          "otpSubmitSelector": "button.hui-btn-primary-highlight",
          "expectedPostLoginUrl": "https://demo4.holistics.io/home",
