{
  "version": 1,
  "command_classes": {
    "amp-claude-selector": {
      "executableNames": ["amp-claude-selector"]
    },
    "braintrust-export": {
      "executableNames": ["braintrust-export"]
    },
    "slb-harness": {
      "executableNames": ["python", "python3"]
    },
    "amp": {
      "executableNames": ["amp"]
    },
    "claude-code": {
      "executableNames": ["claude"]
    },
    "pi": {
      "executableNames": ["pi"]
    },
    "amp-runner-rclone": {
      "executableNames": ["rclone"]
    },
    "smartclass-wrangler-dev": {
      "executableNames": ["smartclass-wrangler-dev"]
    },
    "smartclass-openrouter-poc": {
      "executableNames": ["python", "python3"]
    },
    "logseq-agent-preflight": {
      "executableNames": ["validate-agent-credentials"]
    },
    "logseq-publisher": {
      "executableNames": ["publish-approved-output"]
    },
    "github-cli": {
      "executableNames": ["gh"]
    },
    "smartclass-teacher-api": {
      "executableNames": ["node"]
    }
  },
  "bundles": {
    "amp-claude-selector": {
      "audience": "agent",
      "owner": "lelouvincx/agent-skills",
      "variables": ["CLIPROXY_MANAGEMENT_KEY"],
      "compatibleBundles": [],
      "allowedCommandClasses": ["amp-claude-selector"]
    },
    "braintrust-export": {
      "audience": "agent",
      "owner": "holistics/demo-amql-sl-benchmark",
      "variables": ["BRAINTRUST_API_KEY"],
      "compatibleBundles": [],
      "allowedCommandClasses": ["braintrust-export"]
    },
    "slb-databricks": {
      "audience": "agent",
      "owner": "holistics/demo-amql-sl-benchmark",
      "variables": ["DATABRICKS_TOKEN"],
      "compatibleBundles": [],
      "allowedCommandClasses": ["slb-harness"]
    },
    "slb-snowflake": {
      "audience": "agent",
      "owner": "holistics/demo-amql-sl-benchmark",
      "variables": ["SNOWFLAKE_PAT"],
      "compatibleBundles": [],
      "allowedCommandClasses": ["slb-harness"]
    },
    "amp-runtime": {
      "audience": "agent",
      "owner": "lelouvincx/agent-skills",
      "variables": ["AMP_API_KEY"],
      "compatibleBundles": ["work"],
      "allowedCommandClasses": ["amp", "logseq-agent-preflight"]
    },
    "work": {
      "audience": "agent",
      "owner": "lelouvincx/agent-skills",
      "variables": [
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "HOLISTICS_DEMO4_USERNAME",
        "HOLISTICS_DEMO4_PASSWORD",
        "HOLISTICS_DEMO4_OTP",
        "HOLISTICS_TESTING4_USERNAME",
        "HOLISTICS_TESTING4_PASSWORD",
        "HOLISTICS_TESTING4_API_KEY"
      ],
      "compatibleBundles": ["amp-runtime"],
      "allowedCommandClasses": [
        "amp",
        "claude-code",
        "pi",
        "logseq-agent-preflight"
      ]
    },
    "lelouvincx-bot": {
      "audience": "publisher",
      "owner": "lelouvincx/second-brain-logseq",
      "variables": ["GH_TOKEN"],
      "compatibleBundles": [],
      "allowedCommandClasses": ["github-cli", "logseq-publisher"]
    },
    "amp-runner-r2": {
      "audience": "publisher",
      "owner": "lelouvincx/agent-skills",
      "variables": ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY"],
      "compatibleBundles": [],
      "allowedCommandClasses": ["amp-runner-rclone"]
    },
    "smartclass-cohere": {
      "audience": "agent",
      "owner": "lelouvincx/smartclass",
      "variables": ["COHERE_API_KEY"],
      "compatibleBundles": ["openrouter"],
      "allowedCommandClasses": ["smartclass-wrangler-dev"]
    },
    "openrouter": {
      "audience": "agent",
      "owner": "lelouvincx/smartclass",
      "variables": ["OPENROUTER_API_KEY"],
      "compatibleBundles": ["smartclass-cohere"],
      "allowedCommandClasses": [
        "smartclass-openrouter-poc",
        "smartclass-wrangler-dev"
      ]
    },
    "toanthaythanh-teacher": {
      "audience": "agent",
      "owner": "lelouvincx/smartclass",
      "variables": [
        "TOANTHAYTHANH_TEACHER_PHONE",
        "TOANTHAYTHANH_TEACHER_PASSWORD"
      ],
      "compatibleBundles": [],
      "allowedCommandClasses": ["smartclass-teacher-api"]
    }
  }
}
