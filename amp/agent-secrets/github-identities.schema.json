{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lelouvincx/agent-skills/amp/agent-secrets/github-identities.schema.json",
  "title": "Shared GitHub identity access policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "identities"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "identities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/identity"
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryAllowlist"
      ],
      "properties": {
        "repositoryAllowlist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/[a-z0-9._-]+$"
          }
        }
      }
    }
  }
}
