#!/usr/bin/env python3
"""Start SmartClass's local Wrangler dev server with its DeepSeek secret."""

import os
import sys


PROJECT = "/Users/lelouvincx/Developer/smartclass"
HOME = "/Users/lelouvincx"
NODE_DIRECTORY = f"{HOME}/.local/share/mise/installs/node/latest/bin"
NODE = f"{NODE_DIRECTORY}/node"
WRANGLER = f"{PROJECT}/node_modules/wrangler/bin/wrangler.js"
DEV_VARS = f"{PROJECT}/.dev.vars"
SECRET = "DEEPSEEK_API_KEY"


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in {"dev", "probe"}:
        print("usage: smartclass-wrangler-dev {dev|probe}", file=sys.stderr)
        return 2
    if not os.environ.get(SECRET):
        print(f"smartclass-wrangler-dev: {SECRET} is unavailable", file=sys.stderr)
        return 1
    if sys.argv[1] == "probe":
        print(f"{SECRET} is present")
        return 0
    if (
        not os.path.isfile(NODE)
        or not os.access(NODE, os.X_OK)
        or not os.path.isfile(WRANGLER)
    ):
        print("smartclass-wrangler-dev: local Node or Wrangler is unavailable", file=sys.stderr)
        return 1

    environment = {
        name: value
        for name, value in os.environ.items()
        if name in {"LANG", "TERM", "TMPDIR"} or name.startswith("LC_")
    }
    environment["HOME"] = HOME
    environment["PATH"] = f"{NODE_DIRECTORY}:/opt/homebrew/bin:/usr/bin:/bin"
    environment[SECRET] = os.environ[SECRET]
    environment["CLOUDFLARE_INCLUDE_PROCESS_ENV"] = "true"
    os.chdir(PROJECT)
    os.execve(
        NODE,
        [NODE, WRANGLER, "dev", "--local", "--env-file", DEV_VARS],
        environment,
    )


if __name__ == "__main__":
    raise SystemExit(main())
