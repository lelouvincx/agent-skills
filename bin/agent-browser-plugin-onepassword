#!/usr/bin/env python3
"""Resolve approved agent-browser credentials through agent-secrets."""

import json
import os
import re
import signal
import subprocess
import sys
from pathlib import Path


PROTOCOL = "agent-browser.plugin.v1"
CREDENTIAL_CONTRACT = "rfc0011-v1"
RESOLUTION_TIMEOUT_SECONDS = 110
MAX_REQUEST_BYTES = 64 * 1024
NAME_PATTERN = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
REQUEST_KEYS = {"credentialContract", "profileName", "itemRef", "url"}
INTERNAL_CREDENTIAL_KEYS = {
    "username",
    "password",
    "url",
    "credentialOrigin",
    "usernameSelector",
    "passwordSelector",
    "submitSelector",
    "otp",
    "otpSelector",
    "otpSubmitSelector",
    "expectedPostLoginUrl",
    "accountMarkerSelector",
    "accountMarkerValue",
}
NATIVE_CREDENTIAL_KEYS = (
    "username",
    "password",
    "url",
    "usernameSelector",
    "passwordSelector",
    "submitSelector",
    "credentialOrigin",
    "expectedPostLoginUrl",
    "accountMarkerSelector",
    "accountMarkerValue",
)
active_process = None


class RequestError(ValueError):
    """A malformed or unsupported native plugin request."""


def reject_duplicate_keys(pairs):
    value = {}
    for key, child in pairs:
        if key in value:
            raise RequestError("duplicate key")
        value[key] = child
    return value


def response(success, **fields):
    return {"protocol": PROTOCOL, "success": success, **fields}


def read_request(stream):
    raw = stream.read(MAX_REQUEST_BYTES + 1)
    if len(raw) > MAX_REQUEST_BYTES:
        raise RequestError("request is too large")
    try:
        value = json.loads(raw, object_pairs_hook=reject_duplicate_keys)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise RequestError("invalid JSON") from error
    if not isinstance(value, dict) or set(value) != {"protocol", "type", "capability", "request"}:
        raise RequestError("invalid envelope")
    if value["protocol"] != PROTOCOL:
        raise RequestError("unsupported protocol")
    return value


def manifest_for(request):
    if request["type"] != "plugin.manifest" or request["capability"] != "plugin.manifest":
        return None
    if request["request"] != {}:
        raise RequestError("invalid manifest request")
    return response(
        True,
        manifest={
            "name": "onepassword",
            "capabilities": ["credential.read"],
            "description": "Resolve approved 1Password browser logins through agent-secrets",
        },
    )


def credential_request(request):
    if request["type"] != "credential.resolve" or request["capability"] != "credential.read":
        raise RequestError("unsupported request")
    payload = request["request"]
    if (
        not isinstance(payload, dict)
        or payload.get("credentialContract") != CREDENTIAL_CONTRACT
        or "profileName" not in payload
        or set(payload) - REQUEST_KEYS
    ):
        raise RequestError("invalid credential request")
    profile_name = payload["profileName"]
    if not isinstance(profile_name, str) or not NAME_PATTERN.fullmatch(profile_name):
        raise RequestError("invalid profile name")
    normalized = {
        "profileName": profile_name,
        "itemRef": payload.get("itemRef"),
        "url": payload.get("url"),
    }
    for field in ("itemRef", "url"):
        if normalized[field] is not None and not isinstance(normalized[field], str):
            raise RequestError(f"invalid {field}")
    return normalized


def resolver_command(payload):
    directory = Path(__file__).resolve().parent
    command = [
        str(directory / "agent-secrets"),
        "run",
        "--strict-service-account",
        "--browser-login",
        payload["profileName"],
    ]
    if payload["itemRef"] is not None:
        command.extend(("--requested-item", payload["itemRef"]))
    if payload["url"] is not None:
        command.extend(("--requested-url", payload["url"]))
    command.extend(("--", str(directory / "agent-browser-credential-response")))
    return command


def end_process_group(process):
    if process.poll() is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
        process.wait(timeout=1)
    except (ProcessLookupError, subprocess.TimeoutExpired):
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()
    if process.stdout is not None:
        process.stdout.close()


def run_resolver(command, environment, timeout=RESOLUTION_TIMEOUT_SECONDS):
    global active_process
    process = subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        env=environment,
        start_new_session=True,
    )
    active_process = process
    try:
        stdout, _ = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        end_process_group(process)
        raise RequestError("resolution timed out")
    finally:
        active_process = None
    if process.returncode != 0:
        raise RequestError("resolution failed")
    try:
        credential = json.loads(stdout, object_pairs_hook=reject_duplicate_keys)
    except (json.JSONDecodeError, RequestError) as error:
        raise RequestError("invalid resolver response") from error
    if not isinstance(credential, dict):
        raise RequestError("invalid resolver response")
    required = INTERNAL_CREDENTIAL_KEYS - {"otp", "otpSelector", "otpSubmitSelector"}
    optional = {"otp", "otpSelector", "otpSubmitSelector"}
    if not required.issubset(credential) or set(credential) - INTERNAL_CREDENTIAL_KEYS:
        raise RequestError("invalid resolver response")
    if any(field in credential for field in optional) and not optional.issubset(credential):
        raise RequestError("invalid resolver response")
    if any(not isinstance(value, str) or not value for value in credential.values()):
        raise RequestError("incomplete resolver response")
    return credential


def handle_signal(_signum, _frame):
    if active_process is not None:
        end_process_group(active_process)
    raise SystemExit(1)


def main(stream=None, environment=None):
    stream = sys.stdin.buffer if stream is None else stream
    environment = dict(os.environ if environment is None else environment)
    try:
        request = read_request(stream)
        manifest = manifest_for(request)
        if manifest is not None:
            result = manifest
        else:
            payload = credential_request(request)
            internal = run_resolver(resolver_command(payload), environment)
            credential = {key: internal[key] for key in NATIVE_CREDENTIAL_KEYS}
            for key in ("otp", "otpSelector", "otpSubmitSelector"):
                if key in internal:
                    credential[key] = internal[key]
            internal.clear()
            result = response(True, credential=credential)
    except (OSError, RequestError):
        result = response(False, error="credential resolution failed")
    json.dump(result, sys.stdout, separators=(",", ":"))
    return 0


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, handle_signal)
    signal.signal(signal.SIGINT, handle_signal)
    raise SystemExit(main())
