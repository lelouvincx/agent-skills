#!/usr/bin/env python3
"""Select Claude OAuth credentials through a local CLIProxyAPI v7 Management API."""

import argparse
import datetime as dt
import email.utils
import fcntl
import hashlib
import json
import math
import os
import plistlib
import re
import shutil
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

LABEL = "com.ampcode.claude-subscription-selector"
STATE = Path(
    os.environ.get(
        "AMP_CLAUDE_SELECTOR_STATE_DIR",
        Path.home() / ".local/state/amp-claude-subscription-selector",
    )
)
AGENT = Path.home() / "Library/LaunchAgents" / f"{LABEL}.plist"
CURL_IMAGE = "curlimages/curl:8.12.1"
KEY_VARIABLE = "CLIPROXY_MANAGEMENT_KEY"


class SelectorError(Exception):
    pass


def command(args, data=None):
    environment = dict(os.environ)
    for name in (KEY_VARIABLE, "OP_SERVICE_ACCOUNT_TOKEN", "AGENT_SECRET_AUTH"):
        environment.pop(name, None)
    try:
        result = subprocess.run(
            args,
            input=data,
            text=True,
            capture_output=True,
            timeout=90,
            check=False,
            env=environment,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise SelectorError(f"Could not execute {Path(args[0]).name}") from exc
    if result.returncode:
        # Tool output can contain credentials, OAuth URLs or response bodies.
        raise SelectorError(f"{Path(args[0]).name} failed (exit {result.returncode})")
    return result.stdout


def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temp = path.with_name(path.name + f".tmp.{os.getpid()}")
    try:
        with temp.open("w") as stream:
            os.chmod(temp, 0o600)
            json.dump(value, stream, indent=2, allow_nan=False)
            stream.write("\n")
        temp.replace(path)
    finally:
        temp.unlink(missing_ok=True)


def load():
    try:
        return json.loads((STATE / "config.json").read_text())
    except (OSError, ValueError) as exc:
        raise SelectorError("Not configured; run install first") from exc


def secret():
    value = os.environ.get(KEY_VARIABLE, "")
    if not value or any(char in value for char in "\r\n"):
        raise SelectorError("Management key is empty or contains a newline")
    return value


class API:
    def __init__(self, config):
        self.config = config
        self.key = secret()

    def call(self, method, endpoint, payload=None):
        # Share only the proxy's network namespace. The key travels on stdin,
        # never in Docker arguments, environment, config files or logs.
        options = [
            "silent",
            "show-error",
            "fail-with-body",
            "max-time = 45",
            "url = " + json.dumps("http://127.0.0.1:8317/v0/management/" + endpoint),
            "request = " + json.dumps(method),
            "header = " + json.dumps("Authorization: Bearer " + self.key),
        ]
        if payload is not None:
            options += [
                'header = "Content-Type: application/json"',
                "data = " + json.dumps(json.dumps(payload)),
            ]
        output = command(
            [
                self.config["docker"],
                "run",
                "--rm",
                "-i",
                "--network",
                "container:" + self.config["container"],
                CURL_IMAGE,
                "--config",
                "-",
            ],
            "\n".join(options) + "\n",
        )
        try:
            response = json.loads(output)
        except ValueError as exc:
            raise SelectorError("Management API returned invalid JSON") from exc
        if endpoint.startswith("usage-queue?"):
            if not isinstance(response, list):
                raise SelectorError("Management API returned an invalid usage queue")
            return response
        if not isinstance(response, dict):
            raise SelectorError("Management API response is not an object")
        return response

    def accounts(self):
        response = self.call("GET", "auth-files")
        if not isinstance(response, dict) or not isinstance(
            response.get("files"), list
        ):
            raise SelectorError("Management API returned an invalid account list")
        if any(not isinstance(a, dict) for a in response["files"]):
            raise SelectorError("Management API returned an invalid account entry")
        return [a for a in response["files"] if a.get("provider") == "claude"]

    def quota(self, account, window):
        request = {
            "auth_index": account["auth_index"],
            "method": "GET",
            "url": "https://api.anthropic.com/api/oauth/usage",
            "header": {
                "Authorization": "Bearer $TOKEN$",
                "anthropic-beta": "oauth-2025-04-20",
                "Content-Type": "application/json",
                "User-Agent": "claude-cli/2.1.280 (external, cli)",
            },
        }
        response = self.call("POST", "api-call", request)
        if response.get("status_code") == 401:
            self.call(
                "POST",
                "auth-files/refresh",
                {"name": account["name"], "auth_index": account["auth_index"]},
            )
            # One retry only, including for disabled credentials with expired tokens.
            response = self.call("POST", "api-call", request)
        for attempt in range(2):
            if response.get("status_code") != 429:
                break
            delay = rate_limit_delay(response, attempt)
            if delay > 60:
                break
            time.sleep(delay)
            response = self.call("POST", "api-call", request)
        if response.get("status_code") != 200:
            status = response.get("status_code")
            detail = f" (HTTP {status})" if type(status) is int else ""
            if status == 429:
                detail += (
                    f"; retry after {math.ceil(rate_limit_delay(response, 0))} seconds"
                )
            raise SelectorError("Claude usage request failed" + detail)
        try:
            return parse_quota(json.loads(response["body"]), window)
        except (KeyError, TypeError, ValueError) as exc:
            raise SelectorError("Claude usage response is invalid") from exc

    def disable(self, account, disabled):
        response = self.call(
            "PATCH",
            "auth-files/status",
            {
                "name": account["name"],
                "auth_index": account["auth_index"],
                "disabled": disabled,
            },
        )
        if response.get("status") != "ok" or response.get("disabled") is not disabled:
            raise SelectorError("Credential status update was not confirmed")


def rate_limit_delay(response, attempt):
    delay = 5 * 2**attempt
    headers = response.get("header")
    if not isinstance(headers, dict):
        return delay
    value = next((v for k, v in headers.items() if k.lower() == "retry-after"), None)
    if isinstance(value, list):
        value = value[0] if value else None
    if not isinstance(value, str):
        return delay
    try:
        seconds = int(value)
    except ValueError:
        try:
            reset = email.utils.parsedate_to_datetime(value)
            if reset.tzinfo is None:
                return delay
            seconds = reset.timestamp() - time.time()
        except (TypeError, ValueError, OverflowError):
            return delay
    return max(delay, seconds)


def parse_quota(payload, window):
    keys = {
        "weekly": ["seven_day"],
        "five-hour": ["five_hour"],
        "either": ["five_hour", "seven_day"],
    }[window]
    result = {}
    if not isinstance(payload, dict):
        raise SelectorError("Claude usage response is not an object")
    for key in keys:
        entry = payload.get(key)
        used = entry.get("utilization") if isinstance(entry, dict) else None
        if (
            isinstance(used, bool)
            or not isinstance(used, (int, float))
            or not math.isfinite(used)
            or not 0 <= used <= 100
        ):
            raise SelectorError(f"No usable {key} quota")
        reset = entry.get("resets_at")
        if reset is not None and not isinstance(reset, str):
            raise SelectorError("Invalid quota reset timestamp")
        result[key] = {"remaining": 100 - used, "resets_at": reset}
    return result


def resolve(accounts, name):
    matches = [a for a in accounts if a.get("name") == name]
    if (
        len(matches) != 1
        or not matches[0].get("auth_index")
        or type(matches[0].get("disabled")) is not bool
        or matches[0].get("source") != "file"
        or matches[0].get("runtime_only")
    ):
        raise SelectorError(f"Account not uniquely available: {name}")
    return matches[0]


class NativeClaude:
    def __init__(self, config):
        self.ids = {
            role: config.get("amp_" + role) for role in ("preferred", "fallback")
        }
        self.amp = shutil.which("amp")
        if (
            not self.amp
            or not all(isinstance(value, str) and value for value in self.ids.values())
            or len(set(self.ids.values())) != 2
        ):
            raise SelectorError(
                "Amp sync requires amp and two distinct Claude connection IDs"
            )
        self.states()

    def states(self):
        states = {}
        for role, connection in self.ids.items():
            try:
                entry = json.loads(
                    command([self.amp, "config", "model-providers", "show", connection])
                )
            except ValueError as exc:
                raise SelectorError("Amp returned invalid connection JSON") from exc
            if (
                not isinstance(entry, dict)
                or entry.get("id") != connection
                or entry.get("type") != "model_provider_claude_sub"
                or type(entry.get("active")) is not bool
            ):
                raise SelectorError(
                    "Amp sync requires Claude subscription connection IDs, not list indexes"
                )
            states[role] = entry["active"]
        return states

    def select(self, selected):
        other = "fallback" if selected == "preferred" else "preferred"
        states = self.states()
        # Claude activation replaces the active subscription of the same type.
        if not states[selected]:
            command(
                [self.amp, "config", "model-providers", "activate", self.ids[selected]]
            )
        states = self.states()
        if not states[selected]:
            raise SelectorError("Amp Claude activation verification failed")
        if states[other]:
            command(
                [
                    self.amp,
                    "config",
                    "model-providers",
                    "deactivate",
                    self.ids[other],
                    "--yes",
                ]
            )
        states = self.states()
        if not states[selected] or states[other]:
            raise SelectorError("Amp Claude account selection verification failed")


def switch(api, config, selected):
    # Preflight native connections before changing either proxy credential.
    native = (
        NativeClaude(config)
        if any(config.get("amp_" + role) for role in ("preferred", "fallback"))
        else None
    )
    accounts = api.accounts()
    preferred = resolve(accounts, config["preferred"])
    fallback = resolve(accounts, config["fallback"])
    if {a["name"] for a in accounts} != {preferred["name"], fallback["name"]}:
        raise SelectorError(
            "Unexpected Claude credentials; selection would not be exclusive"
        )
    target = preferred if selected == "preferred" else fallback
    other = fallback if selected == "preferred" else preferred
    # Fail closed: never briefly make both company and personal eligible.
    # A failed enable may leave no eligible account; do not silently restore it.
    if not other["disabled"]:
        api.disable(other, True)
    if target["disabled"]:
        api.disable(target, False)
    after = api.accounts()
    if (
        {a["name"] for a in after} != {target["name"], other["name"]}
        or resolve(after, target["name"])["disabled"]
        or not resolve(after, other["name"])["disabled"]
    ):
        raise SelectorError("Account selection verification failed")
    if native:
        try:
            native.select(selected)
        except (SelectorError, ValueError, TypeError) as exc:
            raise SelectorError(
                "Proxy selected account, but Amp sync failed; accounts may be out of sync. Retry run or paused use."
            ) from exc


def check(api, config):
    accounts = api.accounts()
    quotas = {
        role: api.quota(resolve(accounts, config[role]), config["window"])
        for role in ("preferred", "fallback")
    }
    preferred_available = all(
        q["remaining"] > config["threshold"] for q in quotas["preferred"].values()
    )
    selected = "preferred" if preferred_available else "fallback"
    switch(api, config, selected)
    return {
        "selected": selected,
        "quotas": quotas,
        "reason": "preferred subscription still has remaining quota"
        if preferred_available
        else "preferred subscription is at or below the remaining quota threshold",
    }


def record(result):
    result["timestamp"] = dt.datetime.now(dt.timezone.utc).isoformat()
    save(STATE / "last-run.json", result)
    with (STATE / "selector.log").open("a") as stream:
        os.chmod(STATE / "selector.log", 0o600)
        stream.write(f"{result['timestamp']} {result['result']}: {result['reason']}\n")


def agent_loaded():
    result = subprocess.run(
        ["launchctl", "print", f"gui/{os.getuid()}/{LABEL}"],
        capture_output=True,
        text=True,
        check=False,
        timeout=15,
    )
    if result.returncode == 0:
        return True
    if "Could not find service" in result.stderr + result.stdout:
        return False
    raise SelectorError("Could not inspect LaunchAgent state")


def bootout():
    if agent_loaded():
        command(["launchctl", "bootout", f"gui/{os.getuid()}/{LABEL}"])


def bootstrap():
    command(["launchctl", "bootstrap", f"gui/{os.getuid()}", str(AGENT)])


def schedule(config):
    python = str(Path(sys.executable).resolve())
    script = str(Path(__file__).resolve())
    plist = {
        "Label": LABEL,
        "ProgramArguments": [python, script, "run"],
        "StartInterval": config["interval"],
        "RunAtLoad": True,
        "EnvironmentVariables": {
            "HOME": str(Path.home()),
            "PATH": os.environ.get("PATH", ""),
            "AMP_CLAUDE_SELECTOR_STATE_DIR": str(STATE),
        },
        "StandardOutPath": "/dev/null",
        "StandardErrorPath": "/dev/null",
    }
    AGENT.parent.mkdir(parents=True, exist_ok=True)
    with AGENT.open("wb") as stream:
        os.chmod(AGENT, 0o600)
        plistlib.dump(plist, stream)


def setup_management(args):
    # Update only the reviewed remote-management block, never print config.
    runtime = Path(args.runtime).expanduser()
    path = runtime / "config.yaml"
    original = path.read_text()
    pattern = r"(?m)^remote-management:\n(?:(?:[ \t]+[^\n]*|[ \t]*)\n)*"
    blocks = re.findall(pattern, original)
    if len(blocks) != 1 or not re.search(r"(?m)^  allow-remote: false\s*$", blocks[0]):
        raise SelectorError(
            "Expected one local-only remote-management block; review config manually"
        )
    value = secret()
    hashed = (
        command(["/usr/sbin/htpasswd", "-niBC", "12", "selector"], value + "\n")
        .strip()
        .split(":", 1)[1]
    )
    block, count = re.subn(
        r"(?m)^  secret-key:.*$", "  secret-key: " + json.dumps(hashed), blocks[0]
    )
    if count != 1:
        raise SelectorError("Expected one management secret-key field")
    replacement = original.replace(blocks[0], block, 1)
    temp = path.with_name("config.yaml.selector-tmp")
    try:
        with temp.open("w") as stream:
            os.chmod(temp, 0o600)
            stream.write(replacement)
        temp.replace(path)
    finally:
        temp.unlink(missing_ok=True)
    print(
        "Management key hash configured; restart the proxy to enable it. Remote management remains disabled."
    )


def positive(value):
    number = int(value)
    if number <= 0:
        raise argparse.ArgumentTypeError("Must be positive")
    return number


def percent(value):
    number = float(value)
    if not math.isfinite(number) or not 0 <= number <= 100:
        raise argparse.ArgumentTypeError("Must be between 0 and 100")
    return number


def format_interval(seconds):
    for size, unit in ((3600, "hour"), (60, "minute"), (1, "second")):
        if seconds >= size and seconds % size == 0:
            count = seconds // size
            return f"{count} {unit}{'s' if count != 1 else ''}"


def format_timestamp(timestamp, offset=0):
    if timestamp == "never":
        return timestamp
    try:
        value = dt.datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
        if value.tzinfo is None:
            return "unknown"
        value = (value + dt.timedelta(seconds=offset)).astimezone(
            dt.timezone(dt.timedelta(hours=7))
        )
        return value.strftime("%Y-%m-%d %H:%M:%S UTC+7")
    except (ValueError, TypeError, AttributeError):
        return "unknown"


def status_report(config):
    last = (
        json.loads((STATE / "last-run.json").read_text())
        if (STATE / "last-run.json").exists()
        else {}
    )
    state = (
        "paused"
        if (STATE / "paused").exists()
        else "scheduled"
        if agent_loaded()
        else "not scheduled"
    )
    timestamp = last.get("timestamp", "never")
    next_check = (
        state
        if state != "scheduled"
        else "awaiting first check"
        if timestamp == "never"
        else format_timestamp(timestamp, config["interval"])
    )
    selected = last.get("selected", "none")
    labels = {
        "preferred": f"company ({config['preferred']})",
        "fallback": f"personal ({config['fallback']})",
    }
    reason = last.get("reason", "selector has not run yet")
    if reason == "Selected account has capacity":
        reason = (
            "preferred subscription still has remaining quota"
            if selected == "preferred"
            else "preferred subscription is at or below the remaining quota threshold"
        )
    windows = {
        "weekly": [("seven_day", "weekly")],
        "five-hour": [("five_hour", "five-hour")],
        "either": [("five_hour", "five-hour"), ("seven_day", "weekly")],
    }[config["window"]]

    def remaining(role):
        quota = last.get("quotas", {}).get(role, {})
        parts = []
        for key, label in windows:
            value = quota.get(key, {}).get("remaining")
            text = (
                f"{value:g}%"
                if isinstance(value, (int, float))
                and not isinstance(value, bool)
                and math.isfinite(value)
                and 0 <= value <= 100
                else "unknown"
            )
            parts.append(f"{label} {text}")
        return "; ".join(parts)

    result = last.get("result", "never run")
    print(f"Preferred: {labels['preferred']}")
    print(f"Fallback: {labels['fallback']}")
    print(f"Threshold: {config['threshold']:g}% remaining")
    print(f"Interval: {format_interval(config['interval'])}")
    print(f"Background check: {state}")
    print(f"Last check: {format_timestamp(timestamp)}")
    print(f"Next check: {next_check}")
    print(f"Result: {'never run' if result == 'never-run' else result}")
    print(f"Selected: {labels.get(selected, selected)}")
    print(f"Preferred remaining: {remaining('preferred')}")
    print(f"Fallback remaining: {remaining('fallback')}")
    print(f"Reason: {reason}")
    if config.get("amp_preferred"):
        print(
            f"Amp connections: company {config['amp_preferred']}; personal {config['amp_fallback']}"
        )


USAGE_LABEL = "com.ampcode.claude-work-usage"


def usage_account(api, config):
    account = resolve(api.accounts(), config["preferred"])
    email = account.get("email", "")
    if (
        not isinstance(email, str)
        or not email.endswith("@holistics.io")
        or not account["name"].endswith("-" + email + ".json")
    ):
        raise SelectorError(
            "Work credential email is not verified by the provider account list"
        )
    return {
        "name": account["name"],
        "email": email,
        "auth_index": account["auth_index"],
    }


def usage_database():
    database = sqlite3.connect(STATE / "work-usage.sqlite")
    database.execute("pragma synchronous=full")
    database.execute(
        "create table if not exists requests (request_key text primary key, payload text not null)"
    )
    os.chmod(STATE / "work-usage.sqlite", 0o600)
    return database


def usage_row(record, account):
    # Never save raw queue payloads: they include API keys and response headers.
    if not isinstance(record, dict):
        return None
    if (
        record.get("provider") != "claude"
        or record.get("auth_index") != account["auth_index"]
    ):
        return None
    breakdown = record.get("token_breakdown", {})
    if breakdown.get("schema_version") != 2 or breakdown.get("quality") != "complete":
        raise SelectorError("Work usage has no complete v2 token breakdown")
    timestamp = record.get("timestamp")
    parsed = dt.datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
    if parsed.tzinfo is None:
        raise SelectorError("Work usage timestamp has no timezone")
    model = record.get("model")
    request_id = record.get("request_id")
    if (
        not isinstance(model, str)
        or not model
        or not isinstance(request_id, str)
        or not request_id
    ):
        raise SelectorError("Work usage is missing model or request identity")
    counts = {
        "uncached_input": breakdown["input"]["uncached_tokens"],
        "output": breakdown["output"]["total_tokens"],
        "cache_read": breakdown["input"]["cache_read_tokens"],
        "cache_write": breakdown["input"]["cache_write_tokens"],
    }
    if any(type(value) is not int or value < 0 for value in counts.values()):
        raise SelectorError("Work usage token counts are invalid")
    if sum(counts.values()) != breakdown.get("total_tokens"):
        raise SelectorError("Work usage token breakdown is inconsistent")
    if type(record.get("failed")) is not bool:
        raise SelectorError("Work usage outcome is missing")
    return {
        "timestamp": timestamp,
        "model": model,
        "request_id": request_id,
        "account": account,
        "failed": record["failed"],
        "tokens": counts,
    }


def collect_usage(api, config):
    binding = json.loads((STATE / "work-usage-account.json").read_text())
    account = usage_account(api, config)
    if account != binding:
        raise SelectorError(
            "Work account identity changed; review before reinstalling tracking"
        )
    if (
        api.call("GET", "usage-statistics-enabled").get("usage-statistics-enabled")
        is not True
    ):
        raise SelectorError("Proxy usage statistics are disabled")
    stored = excluded = rejected = 0
    with usage_database() as database:
        while True:
            records = api.call("GET", "usage-queue?count=1000")
            for item in records:
                try:
                    row = usage_row(item, account)
                except (SelectorError, KeyError, TypeError, ValueError, AttributeError):
                    rejected += 1
                    continue
                if row is None:
                    excluded += 1
                    continue
                # A request can have multiple provider attempts; timestamp and
                # model distinguish those while identical redeliveries deduplicate.
                payload = json.dumps(row, sort_keys=True)
                key = hashlib.sha256(payload.encode()).hexdigest()
                stored += database.execute(
                    "insert or ignore into requests values (?, ?)", (key, payload)
                ).rowcount
            database.commit()
            if len(records) < 1000:
                break
    result = {
        "collected_at": dt.datetime.now(dt.timezone.utc).isoformat(),
        "stored": stored,
        "excluded": excluded,
        "rejected": rejected,
    }
    save(STATE / "work-usage-last.json", result)
    if rejected:
        raise SelectorError(
            "Rejected malformed work usage; inspect work-usage-last.json for count"
        )
    return result


def usage_report(details=False):
    if not (STATE / "work-usage.sqlite").exists():
        raise SelectorError("No durable work history; run usage-install first")
    with usage_database() as database:
        rows = [
            json.loads(row[0])
            for row in database.execute("select payload from requests")
        ]
    totals = dict.fromkeys(("uncached_input", "output", "cache_read", "cache_write"), 0)
    for row in rows:
        for name, value in row["tokens"].items():
            totals[name] += value
    result = {
        "requests": len(rows),
        "tokens": totals,
        "scope": "verified work credentials only",
    }
    if details:
        result["history"] = sorted(rows, key=lambda row: row["timestamp"])
    last = STATE / "work-usage-last.json"
    result["last_collection"] = json.loads(last.read_text()) if last.exists() else None
    print(json.dumps(result, indent=2))


def restart_usage(api, config):
    collect_usage(api, config)
    command([config["docker"], "restart", config["container"]])
    for attempt in range(12):
        try:
            collect_usage(api, config)
            return
        except SelectorError:
            if attempt == 11:
                raise
            time.sleep(2)


def install_usage(api, config, runtime):
    account = usage_account(api, config)
    binding_path = STATE / "work-usage-account.json"
    if binding_path.exists() and json.loads(binding_path.read_text()) != account:
        raise SelectorError(
            "Existing work binding differs; explicit history migration required"
        )
    save(binding_path, account)
    # Keep the bind-mounted inode: atomic replacement would leave Docker reading
    # the old config. Do not print, copy or export any existing secret values.
    path = Path(runtime).expanduser() / "config.yaml"
    original = path.read_text()
    replacement = original
    for name, value in (
        ("usage-statistics-enabled", "true"),
        ("redis-usage-queue-retention-seconds", "3600"),
    ):
        pattern = rf"(?m)^{name}:.*$"
        if len(re.findall(pattern, replacement)) > 1:
            raise SelectorError(
                "Duplicate usage config setting; review config manually"
            )
        replacement = (
            re.sub(pattern, f"{name}: {value}", replacement)
            if re.search(pattern, replacement)
            else replacement.rstrip() + f"\n{name}: {value}\n"
        )
    if (
        api.call("GET", "usage-statistics-enabled").get("usage-statistics-enabled")
        is True
    ):
        collect_usage(api, config)
    with path.open("r+") as stream:
        stream.write(replacement)
        stream.truncate()
        stream.flush()
        os.fsync(stream.fileno())
    # Restart only the existing container, never pull the moving latest tag.
    command([config["docker"], "restart", config["container"]])
    for attempt in range(12):
        try:
            collect_usage(api, config)
            break
        except SelectorError:
            if attempt == 11:
                raise
            time.sleep(2)
    agent = AGENT.with_name(USAGE_LABEL + ".plist")
    plist = {
        "Label": USAGE_LABEL,
        "ProgramArguments": [str(Path(__file__).resolve()), "usage-collect"],
        "StartInterval": 15,
        "RunAtLoad": True,
        "EnvironmentVariables": {
            "HOME": str(Path.home()),
            "PATH": os.environ.get("PATH", ""),
            "AMP_CLAUDE_SELECTOR_STATE_DIR": str(STATE),
        },
        "StandardOutPath": "/dev/null",
        "StandardErrorPath": "/dev/null",
    }
    domain = f"gui/{os.getuid()}"
    if agent.exists():
        command(["launchctl", "bootout", domain, str(agent)])
    agent.parent.mkdir(parents=True, exist_ok=True)
    with agent.open("wb") as stream:
        os.chmod(agent, 0o600)
        plistlib.dump(plist, stream)
    command(["launchctl", "bootstrap", domain, str(agent)])
    print("Work-only usage collector installed; routing unchanged")


def parser():
    root = argparse.ArgumentParser(description=__doc__)
    commands = root.add_subparsers(dest="action", required=True)
    setup = commands.add_parser(
        "setup-management", help="Configure a local-only hashed management key"
    )
    setup.add_argument(
        "--runtime", default=str(Path.home() / ".local/share/amp-cliproxy")
    )
    install = commands.add_parser("install")
    install.add_argument(
        "--preferred", required=True, help="Company Claude auth filename"
    )
    install.add_argument(
        "--fallback", required=True, help="Personal Claude auth filename"
    )
    install.add_argument("--container", default="amp-cliproxyapi")
    for action in (install, commands.add_parser("configure")):
        action.add_argument(
            "--amp-preferred", help="Native Amp work Claude connection UUID"
        )
        action.add_argument(
            "--amp-fallback", help="Native Amp personal Claude connection UUID"
        )
        action.add_argument(
            "--window",
            choices=["weekly", "five-hour", "either"],
            default="weekly" if action is install else None,
        )
        action.add_argument(
            "--threshold", type=percent, default=40 if action is install else None
        )
        action.add_argument(
            "--interval", type=positive, default=3600 if action is install else None
        )
    accounts = commands.add_parser(
        "accounts", help="List credentials before or after install"
    )
    accounts.add_argument("--container", default="amp-cliproxyapi")
    usage_install = commands.add_parser(
        "usage-install", help="Enable work-only durable tracking and restart proxy"
    )
    usage_install.add_argument(
        "--runtime", default=str(Path.home() / ".local/share/amp-cliproxy")
    )
    commands.add_parser(
        "usage-collect", help="Drain usage queue into sanitized work history"
    )
    commands.add_parser(
        "usage-restart",
        help="Drain history, restart existing proxy and verify collection",
    )
    report = commands.add_parser(
        "usage-report", help="Report only durable, verified work history"
    )
    report.add_argument("--details", action="store_true")
    for name in ("run", "status", "pause", "resume", "uninstall"):
        commands.add_parser(name)
    use = commands.add_parser(
        "use", help="Explicit selection; requires paused automation"
    )
    use.add_argument("account", choices=["company", "personal"])
    return root


def main():
    args = parser().parse_args()
    os.umask(0o077)
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(STATE, 0o700)
    needs_key = args.action in {
        "setup-management",
        "install",
        "accounts",
        "use",
        "run",
        "usage-install",
        "usage-collect",
        "usage-restart",
    }
    if args.action == "run" and (STATE / "paused").exists():
        needs_key = False
    if needs_key and KEY_VARIABLE not in os.environ:
        resolver = shutil.which("agent-secrets")
        if not resolver:
            raise SelectorError("agent-secrets is not installed; run sync-skills.sh")
        # Resolve before taking the lock: the approved child takes the same lock.
        result = subprocess.run(
            [
                resolver,
                "run",
                "--strict-service-account",
                "--bundle",
                "amp-claude-selector",
                "--",
                str(Path(__file__).resolve()),
                *sys.argv[1:],
            ],
            check=False,
        )
        # Resolver failures use exit 1. The selector child uses exit 2 and has
        # already recorded its specific failure while holding the selector lock.
        if args.action == "run" and result.returncode == 1:
            record(
                {
                    "result": "failed",
                    "selected": "unknown",
                    "reason": "Agent-secrets resolution failed",
                }
            )
        raise SystemExit(result.returncode)
    with (STATE / "selector.lock").open("a") as lock:
        try:
            # RunAtLoad can start before install/resume releases its lock.
            # Let that check wait rather than lose the first evaluation.
            mode = (
                fcntl.LOCK_EX if args.action == "run" else fcntl.LOCK_EX | fcntl.LOCK_NB
            )
            fcntl.flock(lock, mode)
        except BlockingIOError as exc:
            raise SelectorError("Another selector operation is running") from exc
        if args.action == "setup-management":
            setup_management(args)
            return
        if args.action == "accounts" and not (STATE / "config.json").exists():
            config = {
                "container": args.container,
                "docker": shutil.which("docker") or "docker",
            }
            for account in API(config).accounts():
                print(
                    f"{account['name']}: {'disabled' if account['disabled'] else 'enabled'}"
                )
            return
        if args.action == "install":
            if args.preferred == args.fallback:
                raise SelectorError("Preferred and fallback must differ")
            docker = shutil.which("docker")
            if not docker:
                raise SelectorError("Docker is not installed")
            config = {
                "preferred": args.preferred,
                "fallback": args.fallback,
                "container": args.container,
                "docker": docker,
                "window": args.window,
                "threshold": args.threshold,
                "interval": args.interval,
            }
            if args.amp_preferred is not None or args.amp_fallback is not None:
                config.update(
                    amp_preferred=args.amp_preferred, amp_fallback=args.amp_fallback
                )
                NativeClaude(config)
            api = API(config)
            # Validate both quota payloads before installing an active scheduler.
            accounts = api.accounts()
            if {a["name"] for a in accounts} != {
                config["preferred"],
                config["fallback"],
            }:
                raise SelectorError("Exactly two Claude credentials are required")
            for role in ("preferred", "fallback"):
                api.quota(resolve(accounts, config[role]), config["window"])
            bootout()
            save(STATE / "config.json", config)
            schedule(config)
            (STATE / "paused").touch(mode=0o600)
            bootstrap()
            (STATE / "paused").unlink()
            print("Installed Claude subscription selector")
            return
        if args.action == "uninstall":
            bootout()
            AGENT.unlink(missing_ok=True)
            (STATE / "paused").touch(mode=0o600)
            print("Uninstalled scheduler; account selection unchanged")
            return
        config = load()
        config.pop("management_key_ref", None)
        if args.action == "usage-install":
            install_usage(API(config), config, args.runtime)
        elif args.action == "usage-collect":
            print(json.dumps(collect_usage(API(config), config)))
        elif args.action == "usage-restart":
            restart_usage(API(config), config)
            print("Proxy restarted; durable work history retained")
        elif args.action == "usage-report":
            usage_report(args.details)
        elif args.action == "configure":
            fields = (
                "window",
                "threshold",
                "interval",
                "amp_preferred",
                "amp_fallback",
            )
            if all(getattr(args, field) is None for field in fields):
                raise SelectorError("Provide a policy option or Amp connection IDs")
            for field in fields:
                if getattr(args, field) is not None:
                    config[field] = getattr(args, field)
            if config.get("amp_preferred") or config.get("amp_fallback"):
                NativeClaude(config)
            loaded = agent_loaded()
            bootout()
            (STATE / "paused").touch(mode=0o600)
            save(STATE / "config.json", config)
            schedule(config)
            if loaded:
                bootstrap()
                (STATE / "paused").unlink()
            print("Policy updated")
        elif args.action == "pause":
            bootout()
            (STATE / "paused").touch(mode=0o600)
            print("Paused; account selection unchanged")
        elif args.action == "resume":
            if not AGENT.exists():
                raise SelectorError("Scheduler is not installed")
            if not agent_loaded():
                bootstrap()
            (STATE / "paused").unlink(missing_ok=True)
            print("Resumed")
        elif args.action == "status":
            status_report(config)
        elif args.action == "accounts":
            for account in API(config).accounts():
                print(
                    f"{account['name']}: {'disabled' if account['disabled'] else 'enabled'}"
                )
        elif args.action == "use":
            if not (STATE / "paused").exists() or agent_loaded():
                raise SelectorError("Run pause before explicit account selection")
            switch(
                API(config),
                config,
                "preferred" if args.account == "company" else "fallback",
            )
            print(f"Selected {args.account}")
        elif args.action == "run":
            if (STATE / "paused").exists():
                raise SelectorError("Selector is paused; run resume first")
            try:
                result = check(API(config), config)
                record({"result": "ok", **result})
                print(result["reason"])
            except SelectorError as exc:
                record({"result": "failed", "selected": "unknown", "reason": str(exc)})
                raise


if __name__ == "__main__":
    try:
        main()
    except (
        SelectorError,
        OSError,
        ValueError,
        KeyError,
        TypeError,
        sqlite3.Error,
    ) as error:
        # Avoid emitting potentially sensitive malformed API/config contents.
        message = (
            str(error)
            if isinstance(error, SelectorError)
            else "Invalid configuration or local operation failed"
        )
        print(f"amp-claude-selector: {message}", file=sys.stderr)
        sys.exit(2)
