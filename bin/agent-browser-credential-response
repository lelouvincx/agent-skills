#!/usr/bin/env python3
"""Serialize one validated browser credential from the agent-secrets child environment."""

import json
import os
import sys


FIELDS = {
    "username": "AGENT_BROWSER_LOGIN_USERNAME",
    "password": "AGENT_BROWSER_LOGIN_PASSWORD",
    "url": "AGENT_BROWSER_LOGIN_URL",
    "credentialOrigin": "AGENT_BROWSER_LOGIN_CREDENTIAL_ORIGIN",
    "usernameSelector": "AGENT_BROWSER_LOGIN_USERNAME_SELECTOR",
    "passwordSelector": "AGENT_BROWSER_LOGIN_PASSWORD_SELECTOR",
    "submitSelector": "AGENT_BROWSER_LOGIN_SUBMIT_SELECTOR",
    "expectedPostLoginUrl": "AGENT_BROWSER_LOGIN_EXPECTED_POST_LOGIN_URL",
    "accountMarkerSelector": "AGENT_BROWSER_LOGIN_ACCOUNT_MARKER_SELECTOR",
    "accountMarkerValue": "AGENT_BROWSER_LOGIN_ACCOUNT_MARKER_VALUE",
}
OPTIONAL_FIELDS = {
    "otp": "AGENT_BROWSER_LOGIN_OTP",
    "otpSelector": "AGENT_BROWSER_LOGIN_OTP_SELECTOR",
    "otpSubmitSelector": "AGENT_BROWSER_LOGIN_OTP_SUBMIT_SELECTOR",
}


def main(environment=None):
    environment = os.environ if environment is None else environment
    credential = {field: environment.get(name) for field, name in FIELDS.items()}
    if any(not isinstance(value, str) or not value for value in credential.values()):
        return 1
    optional = {field: environment.get(name) for field, name in OPTIONAL_FIELDS.items()}
    if any(value is not None for value in optional.values()):
        if not all(isinstance(value, str) and value for value in optional.values()):
            return 1
        credential.update(optional)
    json.dump(credential, sys.stdout, separators=(",", ":"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
