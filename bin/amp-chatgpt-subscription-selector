#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
	cat <<'EOF'
Usage:
  amp-chatgpt-subscription-selector install --preferred ID --fallback ID --interval SECONDS [--threshold PERCENT]
  amp-chatgpt-subscription-selector uninstall
  amp-chatgpt-subscription-selector pause
  amp-chatgpt-subscription-selector resume
  amp-chatgpt-subscription-selector run
  amp-chatgpt-subscription-selector status

Keep a preferred Amp ChatGPT subscription active until either its 5-hour or
weekly Codex quota has the configured remaining percentage or less.
EOF
}

fail() { printf 'amp-chatgpt-subscription-selector: %s\n' "$*" >&2; exit 2; }

state_dir="${AMP_CHATGPT_SELECTOR_STATE_DIR:-$HOME/.local/state/amp-chatgpt-subscription-selector}"
launch_agents_dir="${AMP_CHATGPT_SELECTOR_LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
agent_path="$launch_agents_dir/com.ampcode.chatgpt-subscription-selector.plist"
config_file="$state_dir/config"
last_run_file="$state_dir/last-run"
paused_file="$state_dir/paused"
log_file="$state_dir/selector.log"
lock_file="$state_dir/selector.lock"
launchctl_command="${AMP_CHATGPT_SELECTOR_LAUNCHCTL:-/bin/launchctl}"
plutil_command="${AMP_CHATGPT_SELECTOR_PLUTIL:-/usr/bin/plutil}"
lockf_command="${AMP_CHATGPT_SELECTOR_LOCKF:-/usr/bin/lockf}"
preferred=
fallback=
threshold=5
interval=
amp_command="${AMP_CHATGPT_SELECTOR_AMP:-}"

prepare_state() {
	umask 077
	mkdir -p "$state_dir"
	chmod 700 "$state_dir"
	touch "$log_file"
	chmod 600 "$log_file"
}

log() {
	local message="$*"
	printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$message" >> "$log_file"
	printf '%s\n' "$message"
}

write_result() {
	local result="$1" selected="$2" five_remaining="$3" weekly_remaining="$4" fallback_weekly_remaining="$5" detail="$6" tmp="$last_run_file.tmp.$$"
	{
		printf 'timestamp=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
		printf 'result=%s\nselected=%s\nfive_hour_remaining=%s\nweekly_remaining=%s\nfallback_weekly_remaining=%s\ndetail=%s\n' \
			"$result" "$selected" "$five_remaining" "$weekly_remaining" "$fallback_weekly_remaining" "$detail"
	} > "$tmp"
	chmod 600 "$tmp"
	mv "$tmp" "$last_run_file"
}

load_config() {
	[ -f "$config_file" ] || fail 'not configured; run install first'
	while IFS='=' read -r key value; do
		case "$key" in
			PREFERRED) preferred="$value" ;;
			FALLBACK) fallback="$value" ;;
			THRESHOLD) threshold="$value" ;;
			INTERVAL) interval="$value" ;;
			AMP_COMMAND) [ -n "${AMP_CHATGPT_SELECTOR_AMP:-}" ] || amp_command="$value" ;;
		esac
	done < "$config_file"
	[ -n "$preferred" ] && [ -n "$fallback" ] && [ -n "$interval" ] && [ -n "$amp_command" ] || fail 'configuration is incomplete; run install again'
	[ -x "$amp_command" ] || fail "configured Amp command is not executable: $amp_command"
}

acquire_lock() {
	exec 9>> "$lock_file"
	chmod 600 "$lock_file"
	"$lockf_command" -s -t 0 9
}

quota_usage() {
	awk '
		BEGIN { pwindow = pused = swindow = sused = "" }
		{
			key = tolower($1)
			value = $2
			gsub(/\r/, "", value)
			if (key == "x-codex-primary-window-minutes:") pwindow = value
			if (key == "x-codex-primary-used-percent:") pused = value
			if (key == "x-codex-secondary-window-minutes:") swindow = value
			if (key == "x-codex-secondary-used-percent:") sused = value
		}
		END {
			if (pwindow == "" || pused == "" || swindow == "" || sused == "") exit 1
			if (pwindow != 0 && pwindow != 300 && pwindow != 10080) exit 1
			if (swindow != 0 && swindow != 300 && swindow != 10080) exit 1
			if (pwindow != 0 && pwindow == swindow) exit 1
			five = weekly = "unavailable"
			if (pwindow == 300) five = pused
			if (swindow == 300) five = sused
			if (pwindow == 10080) weekly = pused
			if (swindow == 10080) weekly = sused
			if (five == "unavailable" && weekly == "unavailable") exit 1
			print five, weekly
		}
	'
}

valid_percent() {
	awk -v value="$1" 'BEGIN { exit !(value ~ /^[0-9]+([.][0-9]+)?$/ && value >= 0 && value <= 100) }'
}

at_or_below_threshold() {
	[ "$1" != unavailable ] && awk -v used="$1" -v limit="$threshold" 'BEGIN { exit !((100 - used) <= limit) }'
}

format_remaining() {
	if [ "$1" = unavailable ]; then
		printf unavailable
	else
		awk -v used="$1" 'BEGIN { printf "%g", 100 - used }'
	fi
}

weekly_remaining_for_connection() {
	local connection="$1" output usage five_used weekly_used
	output="$("$amp_command" config model-providers test "$connection" 9>&- 2>&1)" || true
	if ! usage="$(printf '%s\n' "$output" | quota_usage)"; then
		printf 'unknown\n'
		return 0
	fi
	read -r five_used weekly_used <<< "$usage"
	if [ "$weekly_used" = unavailable ]; then
		printf 'unavailable\n'
	elif valid_percent "$weekly_used"; then
		format_remaining "$weekly_used"
	else
		printf 'unknown\n'
	fi
}

active_state() {
	local values count
	values="$(sed -nE 's/^[[:space:]]*"active"[[:space:]]*:[[:space:]]*(true|false),?[[:space:]]*$/\1/p')"
	count="$(printf '%s\n' "$values" | awk 'NF { count++ } END { print count + 0 }')"
	[ "$count" -eq 1 ] || return 1
	printf '%s\n' "$values"
}

agent_loaded() {
	local output status
	if output="$("$launchctl_command" print "gui/$(id -u)/com.ampcode.chatgpt-subscription-selector" 9>&- 2>&1)"; then
		return 0
	else
		status=$?
	fi
	if printf '%s\n' "$output" | grep -Fq 'Could not find service'; then
		return 1
	fi
	printf 'amp-chatgpt-subscription-selector: could not inspect LaunchAgent state: %s\n' "$output" >&2
	return "$status"
}

launch_agent_status() {
	if [ -f "$paused_file" ]; then
		printf 'paused\n'
		return 0
	fi
	local output status
	if output="$("$launchctl_command" print "gui/$(id -u)/com.ampcode.chatgpt-subscription-selector" 9>&- 2>&1)"; then
		printf 'scheduled\n'
		return 0
	fi
	status=$?
	if printf '%s\n' "$output" | grep -Fq 'Could not find service'; then
		printf 'not scheduled\n'
		return 0
	fi
	printf 'amp-chatgpt-subscription-selector: could not inspect LaunchAgent state: %s\n' "$output" >&2
	return "$status"
}

connection_label() {
	local id="$1" show name
	[ -n "$id" ] || { printf '%s\n' "$id"; return 0; }
	if show="$("$amp_command" config model-providers show "$id" 9>&- 2>/dev/null)"; then
		name="$(printf '%s\n' "$show" | awk -F'"' '/^[[:space:]]*"name":/{print $4; exit}')"
		if [ -n "$name" ]; then
			printf '%s (%s)\n' "$name" "$id"
			return 0
		fi
	fi
	printf '%s\n' "$id"
}

format_interval() {
	local seconds="$1" hours minutes
	if [ "$seconds" -ge 3600 ] && [ $((seconds % 3600)) -eq 0 ]; then
		hours=$((seconds / 3600))
		if [ "$hours" -eq 1 ]; then
			printf '1 hour\n'
		else
			printf '%s hours\n' "$hours"
		fi
		return 0
	fi
	if [ "$seconds" -ge 60 ] && [ $((seconds % 60)) -eq 0 ]; then
		minutes=$((seconds / 60))
		if [ "$minutes" -eq 1 ]; then
			printf '1 minute\n'
		else
			printf '%s minutes\n' "$minutes"
		fi
		return 0
	fi
	if [ "$seconds" -eq 1 ]; then
		printf '1 second\n'
	else
		printf '%s seconds\n' "$seconds"
	fi
}

format_quota() {
	case "$1" in
		''|unknown) printf 'unknown\n' ;;
		unavailable) printf 'unavailable\n' ;;
		*) printf '%s%%\n' "$1" ;;
	esac
}

format_utc_plus_7() {
	local timestamp="$1" offset_seconds="$2" formatted epoch
	if formatted="$(date -j -u -v+7H -v+"${offset_seconds}"S -f '%Y-%m-%dT%H:%M:%SZ' "$timestamp" '+%Y-%m-%d %H:%M:%S UTC+7' 2>/dev/null)"; then
		printf '%s\n' "$formatted"
		return 0
	fi
	if epoch="$(date -u -d "$timestamp" '+%s' 2>/dev/null)"; then
		date -u -d "@$((epoch + 25200 + offset_seconds))" '+%Y-%m-%d %H:%M:%S UTC+7'
		return 0
	fi
	return 1
}

format_timestamp() {
	case "$1" in
		never) printf 'never\n' ;;
		[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z)
			format_utc_plus_7 "$1" 0 || printf '%s\n' "$1"
			;;
		*) printf '%s\n' "$1" ;;
	esac
}

format_next_check() {
	local timestamp="$1" agent_state="$2" formatted
	case "$agent_state" in
		paused|'not scheduled') printf '%s\n' "$agent_state"; return 0 ;;
	esac
	if [ "$timestamp" = never ]; then
		printf 'awaiting first check\n'
	elif formatted="$(format_utc_plus_7 "$timestamp" "$interval" 2>/dev/null)"; then
		printf '%s\n' "$formatted"
	else
		printf 'unknown\n'
	fi
}

format_result() {
	case "$1" in
		never-run) printf 'never run\n' ;;
		*) printf '%s\n' "$1" ;;
	esac
}

format_detail() {
	case "$1" in
		preferred-has-capacity) printf 'preferred subscription still has remaining quota\n' ;;
		preferred-has-capacity-activated) printf 'preferred subscription still has remaining quota; activated it\n' ;;
		preferred-at-threshold) printf 'preferred subscription is at or below the remaining quota threshold\n' ;;
		preferred-at-threshold-activated) printf 'preferred subscription is at or below the remaining quota threshold; activated the fallback\n' ;;
		quota-windows-missing) printf 'preferred subscription did not report a usable 5-hour or weekly quota window\n' ;;
		provider-test-failed) printf 'preferred subscription test failed and did not report a usable quota window\n' ;;
		invalid-quota-percentage) printf 'preferred subscription returned an invalid quota percentage\n' ;;
		selected-provider-unavailable) printf 'could not inspect the selected subscription\n' ;;
		invalid-selected-provider-state) printf 'selected subscription returned an invalid active state\n' ;;
		activation-failed) printf 'could not activate the selected subscription\n' ;;
		never-run) printf 'selector has not run yet\n' ;;
		*) printf '%s\n' "$1" ;;
	esac
}

run_selector() {
	prepare_state
	if ! acquire_lock; then
		log 'another selector operation is already running'
		return 0
	fi
	load_config
	if [ -f "$paused_file" ]; then
		if agent_loaded; then
			"$launchctl_command" bootout "gui/$(id -u)/com.ampcode.chatgpt-subscription-selector" 9>&- >/dev/null 2>&1 || true
		fi
		fail 'selector is paused; run resume first'
	fi
	local output usage five_used weekly_used five_remaining weekly_remaining fallback_weekly_remaining five_suffix=% weekly_suffix=% selected detail show state test_status=0
	output="$("$amp_command" config model-providers test "$preferred" 9>&- 2>&1)" || test_status=$?
	if ! usage="$(printf '%s\n' "$output" | quota_usage)"; then
		if [ "$test_status" -eq 0 ]; then detail=quota-windows-missing; else detail=provider-test-failed; fi
		write_result failed unchanged unknown unknown unknown "$detail"
		log 'preferred provider response did not provide a usable 5-hour or weekly quota window; kept the current subscription'
		return 1
	fi
	read -r five_used weekly_used <<< "$usage"
	for used in "$five_used" "$weekly_used"; do
		if [ "$used" != unavailable ] && ! valid_percent "$used"; then
			write_result failed unchanged unknown unknown unknown invalid-quota-percentage
			log 'preferred provider returned an invalid quota percentage; kept the current subscription'
			return 1
		fi
	done
	five_remaining="$(format_remaining "$five_used")"
	weekly_remaining="$(format_remaining "$weekly_used")"
	[ "$five_remaining" != unavailable ] || five_suffix=
	[ "$weekly_remaining" != unavailable ] || weekly_suffix=
	selected="$preferred"
	detail=preferred-has-capacity
	if at_or_below_threshold "$five_used" || at_or_below_threshold "$weekly_used"; then
		selected="$fallback"
		detail=preferred-at-threshold
	fi
	if ! show="$("$amp_command" config model-providers show "$selected" 9>&- 2>&1)"; then
		write_result failed unchanged "$five_remaining" "$weekly_remaining" unknown selected-provider-unavailable
		log 'could not inspect the selected provider; kept the current subscription'
		return 1
	fi
	if ! state="$(printf '%s\n' "$show" | active_state)"; then
		write_result failed unchanged "$five_remaining" "$weekly_remaining" unknown invalid-selected-provider-state
		log 'selected provider returned an invalid active state; kept the current subscription'
		return 1
	fi
	if [ "$state" = false ]; then
		if ! "$amp_command" config model-providers activate "$selected" 9>&- >/dev/null; then
			write_result failed unchanged "$five_remaining" "$weekly_remaining" unknown activation-failed
			log 'could not activate the selected provider; kept the current subscription'
			return 1
		fi
		detail="$detail-activated"
	fi
	fallback_weekly_remaining="$(weekly_remaining_for_connection "$fallback")"
	write_result ok "$selected" "$five_remaining" "$weekly_remaining" "$fallback_weekly_remaining" "$detail"
	log "selected $selected; preferred remaining: 5-hour ${five_remaining}${five_suffix}, weekly ${weekly_remaining}${weekly_suffix}"
}

xml_escape() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }
xml_string() { printf '\t\t<string>%s</string>\n' "$(xml_escape "$1")"; }

install_agent() {
	local script_path config_tmp plist_tmp loaded=false state_status
	preferred=
	fallback=
	threshold=5
	interval=
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--preferred) [ "$#" -ge 2 ] || fail '--preferred requires a value'; preferred="$2"; shift 2 ;;
			--fallback) [ "$#" -ge 2 ] || fail '--fallback requires a value'; fallback="$2"; shift 2 ;;
			--threshold) [ "$#" -ge 2 ] || fail '--threshold requires a value'; threshold="$2"; shift 2 ;;
			--interval) [ "$#" -ge 2 ] || fail '--interval requires a value'; interval="$2"; shift 2 ;;
			*) fail "unknown install option: $1" ;;
		esac
	done
	[ -n "$preferred" ] || fail '--preferred is required'
	[ -n "$fallback" ] || fail '--fallback is required'
	[ "$preferred" != "$fallback" ] || fail 'preferred and fallback connections must differ'
	[[ "$threshold" =~ ^[0-9]+$ ]] && [ "$threshold" -le 100 ] || fail '--threshold must be an integer from 0 to 100'
	[ -n "$interval" ] || fail '--interval is required'
	[[ "$interval" =~ ^[1-9][0-9]*$ ]] || fail '--interval must be a positive integer of seconds'
	[ -n "$amp_command" ] || amp_command="$(command -v amp || true)"
	[ -n "$amp_command" ] && [ -x "$amp_command" ] || fail 'could not find an executable Amp CLI'
	amp_command="$(CDPATH= cd -- "$(dirname "$amp_command")" && pwd)/$(basename "$amp_command")"
	for connection in "$preferred" "$fallback"; do
		local connection_json
		connection_json="$("$amp_command" config model-providers show "$connection" 2>&1)" || fail "could not inspect model-provider connection $connection"
		printf '%s\n' "$connection_json" | grep -q '"type": "model_provider_openai_chatgpt"' || fail "$connection is not a ChatGPT subscription"
	done
	prepare_state
	mkdir -p "$launch_agents_dir"
	config_tmp="$config_file.tmp.$$"
	plist_tmp="$agent_path.tmp.$$"
	trap 'rm -f "${config_tmp:-}" "${plist_tmp:-}"' EXIT
	printf 'PREFERRED=%s\nFALLBACK=%s\nTHRESHOLD=%s\nINTERVAL=%s\nAMP_COMMAND=%s\n' "$preferred" "$fallback" "$threshold" "$interval" "$amp_command" > "$config_tmp"
	chmod 600 "$config_tmp"
	script_path="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/$(basename -- "${BASH_SOURCE[0]}")"
	{
		printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' '<plist version="1.0">' '<dict>'
		printf '\t<key>Label</key>\n'; xml_string 'com.ampcode.chatgpt-subscription-selector'
		printf '\t<key>ProgramArguments</key>\n\t<array>\n'; xml_string "$script_path"; xml_string run; printf '\t</array>\n'
		printf '\t<key>EnvironmentVariables</key>\n\t<dict>\n'
		printf '\t\t<key>HOME</key>\n'; xml_string "$HOME"
		printf '\t\t<key>PATH</key>\n'; xml_string "$PATH"
		printf '\t</dict>\n'
		printf '\t<key>RunAtLoad</key>\n\t<true/>\n'
		printf '\t<key>StartInterval</key>\n\t<integer>%s</integer>\n' "$interval"
		printf '\t<key>StandardOutPath</key>\n'; xml_string '/dev/null'
		printf '\t<key>StandardErrorPath</key>\n'; xml_string '/dev/null'
		printf '%s\n' '</dict>' '</plist>'
	} > "$plist_tmp"
	chmod 600 "$plist_tmp"
	"$plutil_command" -lint "$plist_tmp" >/dev/null || fail 'generated LaunchAgent failed validation'
	acquire_lock || fail 'another selector operation is running; retry installation'
	if agent_loaded; then
		loaded=true
	else
		state_status=$?
		[ "$state_status" -eq 1 ] || fail 'could not determine whether the LaunchAgent is loaded'
	fi
	if [ "$loaded" = true ]; then
		"$launchctl_command" bootout "gui/$(id -u)/com.ampcode.chatgpt-subscription-selector" 9>&- >/dev/null || fail 'could not stop the existing LaunchAgent; installation was not changed'
	fi
	rm -f "$paused_file"
	mv "$config_tmp" "$config_file"
	mv "$plist_tmp" "$agent_path"
	"$launchctl_command" bootstrap "gui/$(id -u)" "$agent_path" 9>&-
	trap - EXIT
	printf 'Installed %s\n' "$agent_path"
}

pause_agent() {
	local state_status
	prepare_state
	acquire_lock || fail 'another selector operation is running; retry pause'
	load_config
	[ -f "$agent_path" ] || fail 'selector is not installed; run install first'
	[ ! -f "$paused_file" ] || fail 'selector is already paused'
	if agent_loaded; then
		"$launchctl_command" bootout "gui/$(id -u)/com.ampcode.chatgpt-subscription-selector" 9>&- >/dev/null || fail 'could not stop the LaunchAgent; selector was not paused'
	else
		state_status=$?
		[ "$state_status" -eq 1 ] || fail 'could not determine whether the LaunchAgent is loaded'
		fail 'selector is already paused'
	fi
	touch "$paused_file"
	chmod 600 "$paused_file"
	printf '%s\n' 'Paused ChatGPT subscription selector; the active subscription was unchanged.'
}

resume_agent() {
	local state_status
	prepare_state
	acquire_lock || fail 'another selector operation is running; retry resume'
	load_config
	[ -f "$agent_path" ] || fail 'selector is not installed; run install first'
	[ -f "$paused_file" ] || fail 'selector is not paused'
	if agent_loaded; then
		fail 'selector is not paused'
	else
		state_status=$?
		[ "$state_status" -eq 1 ] || fail 'could not determine whether the LaunchAgent is loaded'
	fi
	rm -f "$paused_file"
	if ! "$launchctl_command" bootstrap "gui/$(id -u)" "$agent_path" 9>&-; then
		touch "$paused_file"
		chmod 600 "$paused_file"
		fail 'could not resume the LaunchAgent'
	fi
	printf '%s\n' 'Resumed ChatGPT subscription selector.'
}

uninstall_agent() {
	local state_status
	prepare_state
	acquire_lock || fail 'another selector operation is running; retry uninstall'
	if agent_loaded; then
		"$launchctl_command" bootout "gui/$(id -u)/com.ampcode.chatgpt-subscription-selector" 9>&- >/dev/null || fail 'could not stop the LaunchAgent; uninstall was not changed'
	else
		state_status=$?
		[ "$state_status" -eq 1 ] || fail 'could not determine whether the LaunchAgent is loaded'
	fi
	rm -f "$agent_path" "$paused_file"
	printf '%s\n' 'Uninstalled ChatGPT subscription selector; the active subscription was unchanged.'
}

status_agent() {
	prepare_state
	load_config
	local last_timestamp=never last_result=never-run last_selected=none
	local last_five=unknown last_weekly=unknown last_fallback_weekly=unknown last_detail=never-run
	local key value agent_state preferred_label fallback_label selected_label
	if [ -f "$last_run_file" ]; then
		while IFS='=' read -r key value; do
			case "$key" in
				timestamp) last_timestamp="$value" ;;
				result) last_result="$value" ;;
				selected) last_selected="$value" ;;
				five_hour_remaining) last_five="$value" ;;
				weekly_remaining) last_weekly="$value" ;;
				fallback_weekly_remaining) last_fallback_weekly="$value" ;;
				detail) last_detail="$value" ;;
			esac
		done < "$last_run_file"
	fi
	preferred_label="$(connection_label "$preferred")"
	fallback_label="$(connection_label "$fallback")"
	case "$last_selected" in
		''|none|unchanged) selected_label="${last_selected:-none}" ;;
		*) selected_label="$(connection_label "$last_selected")" ;;
	esac
	agent_state="$(launch_agent_status)" || return
	printf 'Preferred: %s\n' "$preferred_label"
	printf 'Fallback: %s\n' "$fallback_label"
	printf 'Threshold: %s%% remaining\n' "$threshold"
	printf 'Interval: %s\n' "$(format_interval "$interval")"
	printf 'Background check: %s\n' "$agent_state"
	printf 'Last check: %s\n' "$(format_timestamp "$last_timestamp")"
	printf 'Next check: %s\n' "$(format_next_check "$last_timestamp" "$agent_state")"
	printf 'Result: %s\n' "$(format_result "$last_result")"
	printf 'Selected: %s\n' "$selected_label"
	printf 'Preferred remaining: 5-hour %s, weekly %s\n' "$(format_quota "$last_five")" "$(format_quota "$last_weekly")"
	printf 'Fallback remaining: weekly %s\n' "$(format_quota "$last_fallback_weekly")"
	printf 'Reason: %s\n' "$(format_detail "$last_detail")"
}

[ "$#" -gt 0 ] || { usage >&2; exit 2; }
command_name="$1"
shift
case "$command_name" in
	install) install_agent "$@" ;;
	uninstall) [ "$#" -eq 0 ] || fail 'uninstall takes no arguments'; uninstall_agent ;;
	pause) [ "$#" -eq 0 ] || fail 'pause takes no arguments'; pause_agent ;;
	resume) [ "$#" -eq 0 ] || fail 'resume takes no arguments'; resume_agent ;;
	run) [ "$#" -eq 0 ] || fail 'run takes no arguments'; run_selector ;;
	status) [ "$#" -eq 0 ] || fail 'status takes no arguments'; status_agent ;;
	-h|--help|help) usage ;;
	*) fail "unknown command: $command_name" ;;
esac
