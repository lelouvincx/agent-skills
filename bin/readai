#!/usr/bin/env python3
"""Retrieve Read AI meeting transcripts through its REST API."""

from __future__ import annotations

import argparse
import base64
import contextlib
import datetime as dt
import fcntl
import hashlib
import http.server
import json
import os
import re
import secrets
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from collections.abc import Iterator
from pathlib import Path
from typing import Any
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError

API_BASE = "https://api.read.ai"
REGISTER_URL = f"{API_BASE}/oauth/register"
RESOURCE_URL = f"{API_BASE}/mcp"
AUTHORIZATION_URL = "https://authn.read.ai/oauth2/auth"
TOKEN_URL = "https://authn.read.ai/oauth2/token"
EXPECTED_SCOPES = frozenset(
    {
        "openid",
        "profile",
        "email",
        "offline_access",
        "offline",
        "mcp:execute",
        "meeting:read",
    }
)
SCOPES = " ".join(sorted(EXPECTED_SCOPES))
ITEM_TITLE = "Read AI CLI"
ITEM_VAULT = "Agent Secrets"
OP_ACCOUNT = "my.1password.com"
ULID_PATTERN = re.compile(r"^[0-9A-HJKMNP-TV-Z]{26}$", re.IGNORECASE)
ALLOWED_MEETING_HOSTS = frozenset({"app.read.ai", "read.ai", "www.read.ai"})
TIMEOUT_SECONDS = 30


class ReadAIError(Exception):
    """A safe user-facing failure."""


class AuthenticationError(ReadAIError):
    """Authentication is absent or invalid."""


class TranscriptUnavailable(ReadAIError):
    """A meeting exists but has no transcript yet."""


class HTTPFailure(ReadAIError):
    def __init__(self, status: int, retry_after: str | None = None):
        self.status = status
        self.retry_after = retry_after
        super().__init__(f"Read AI returned HTTP {status}")


class HTTPClient:
    def request(
        self,
        method: str,
        url: str,
        *,
        headers: dict[str, str] | None = None,
        form: dict[str, str] | None = None,
        json_body: dict[str, Any] | None = None,
    ) -> dict[str, Any]:
        request_headers = {
            "Accept": "application/json",
            "User-Agent": "readai-cli/1",
            **(headers or {}),
        }
        body = None
        if form is not None:
            body = urllib.parse.urlencode(form).encode()
            request_headers["Content-Type"] = "application/x-www-form-urlencoded"
        elif json_body is not None:
            body = json.dumps(json_body).encode()
            request_headers["Content-Type"] = "application/json"

        request = urllib.request.Request(
            url, data=body, headers=request_headers, method=method
        )
        try:
            with urllib.request.urlopen(request, timeout=TIMEOUT_SECONDS) as response:
                payload = json.load(response)
        except urllib.error.HTTPError as error:
            raise HTTPFailure(error.code, error.headers.get("Retry-After")) from None
        except urllib.error.URLError as error:
            raise ReadAIError(f"cannot reach Read AI: {error.reason}") from None
        except (json.JSONDecodeError, UnicodeDecodeError):
            raise ReadAIError("Read AI returned an invalid JSON response") from None

        if not isinstance(payload, dict):
            raise ReadAIError("Read AI returned an unexpected response")
        return payload


class OnePasswordStore:
    def _run(
        self, arguments: list[str], *, input_text: str | None = None
    ) -> subprocess.CompletedProcess[str]:
        try:
            result = subprocess.run(
                ["op", *arguments],
                input=input_text,
                text=True,
                capture_output=True,
                check=False,
            )
        except FileNotFoundError:
            raise AuthenticationError("1Password CLI is not installed") from None
        if result.returncode != 0:
            raise AuthenticationError(
                "1Password could not access the Read AI credential item"
            )
        return result

    def _find_item_id(self) -> str | None:
        result = self._run(
            [
                "item",
                "list",
                "--vault",
                ITEM_VAULT,
                "--account",
                OP_ACCOUNT,
                "--format",
                "json",
            ]
        )
        try:
            items = json.loads(result.stdout)
        except json.JSONDecodeError:
            raise AuthenticationError(
                "1Password returned invalid item metadata"
            ) from None
        matches = [item for item in items if item.get("title") == ITEM_TITLE]
        if len(matches) > 1:
            raise AuthenticationError(
                f"1Password contains multiple {ITEM_TITLE!r} items"
            )
        return str(matches[0]["id"]) if matches else None

    def _get_item(self, item_id: str) -> dict[str, Any]:
        result = self._run(
            [
                "item",
                "get",
                item_id,
                "--vault",
                ITEM_VAULT,
                "--account",
                OP_ACCOUNT,
                "--reveal",
                "--format",
                "json",
            ]
        )
        try:
            item = json.loads(result.stdout)
        except json.JSONDecodeError:
            raise AuthenticationError(
                "1Password returned an invalid credential item"
            ) from None
        if not isinstance(item, dict):
            raise AuthenticationError("1Password returned an invalid credential item")
        return item

    @staticmethod
    def _credential_field(item: dict[str, Any]) -> dict[str, Any] | None:
        for field in item.get("fields", []):
            if field.get("id") == "credential":
                if field.get("type") != "CONCEALED":
                    raise AuthenticationError(
                        "the Read AI credential field is not concealed"
                    )
                return field
        return None

    def load(self) -> dict[str, Any]:
        item_id = self._find_item_id()
        if item_id is None:
            raise AuthenticationError("Read AI is not authenticated; run `readai auth`")
        field = self._credential_field(self._get_item(item_id))
        if field is None or not field.get("value"):
            raise AuthenticationError("the Read AI credential item is empty")
        try:
            credentials = json.loads(field["value"])
        except (TypeError, json.JSONDecodeError):
            raise AuthenticationError(
                "the Read AI credential item is invalid"
            ) from None
        if not isinstance(credentials, dict) or credentials.get("version") != 1:
            raise AuthenticationError(
                "the Read AI credential item has an unsupported format"
            )
        return credentials

    def save(self, credentials: dict[str, Any]) -> None:
        credential_json = json.dumps(credentials, separators=(",", ":"))
        item_id = self._find_item_id()
        if item_id is None:
            template_result = self._run(["item", "template", "get", "API Credential"])
            try:
                item = json.loads(template_result.stdout)
            except json.JSONDecodeError:
                raise AuthenticationError(
                    "1Password returned an invalid item template"
                ) from None
            item["title"] = ITEM_TITLE
            field = self._credential_field(item)
            if field is None:
                raise AuthenticationError(
                    "1Password's API credential template is invalid"
                )
            field["value"] = credential_json
            self._run(
                [
                    "item",
                    "create",
                    "--vault",
                    ITEM_VAULT,
                    "--account",
                    OP_ACCOUNT,
                    "-",
                ],
                input_text=json.dumps(item),
            )
            return

        item = self._get_item(item_id)
        field = self._credential_field(item)
        if field is None:
            raise AuthenticationError(
                "the Read AI credential item has no credential field"
            )
        field["value"] = credential_json
        self._run(
            ["item", "edit", item_id, "--vault", ITEM_VAULT, "--account", OP_ACCOUNT],
            input_text=json.dumps(item),
        )


@contextlib.contextmanager
def credential_lock() -> Iterator[None]:
    state_root = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    state_directory = state_root / "readai"
    state_directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(state_directory, 0o700)
    lock_path = state_directory / "credentials.lock"
    descriptor = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    os.chmod(lock_path, 0o600)
    with os.fdopen(descriptor, "r+") as lock_file:
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock_file, fcntl.LOCK_UN)


def validate_scopes(value: Any) -> str:
    if not isinstance(value, str) or set(value.split()) != EXPECTED_SCOPES:
        raise AuthenticationError("Read AI returned unexpected OAuth scopes")
    return value


def updated_credentials(
    current: dict[str, Any], response: dict[str, Any]
) -> dict[str, Any]:
    access_token = response.get("access_token")
    refresh_token = response.get("refresh_token")
    expires_in = response.get("expires_in")
    if not isinstance(access_token, str) or not isinstance(refresh_token, str):
        raise AuthenticationError("Read AI returned an incomplete token response")
    if not isinstance(expires_in, (int, float)) or expires_in <= 0:
        raise AuthenticationError("Read AI returned an invalid token expiry")
    return {
        **current,
        "version": 1,
        "access_token": access_token,
        "refresh_token": refresh_token,
        "expires_at": int(time.time() + expires_in),
        "scope": validate_scopes(response.get("scope")),
        "token_type": response.get("token_type", "bearer"),
    }


class ReadAIClient:
    def __init__(self, store: OnePasswordStore, http: HTTPClient):
        self.store = store
        self.http = http

    @staticmethod
    def _require_client(credentials: dict[str, Any]) -> str:
        client_id = credentials.get("client_id")
        if not isinstance(client_id, str):
            raise AuthenticationError(
                "Read AI client registration is missing; run `readai auth`"
            )
        return client_id

    def _refresh(self, credentials: dict[str, Any]) -> dict[str, Any]:
        client_id = self._require_client(credentials)
        refresh_token = credentials.get("refresh_token")
        if not isinstance(refresh_token, str):
            raise AuthenticationError("Read AI login is incomplete; run `readai auth`")
        try:
            response = self.http.request(
                "POST",
                TOKEN_URL,
                form={
                    "grant_type": "refresh_token",
                    "refresh_token": refresh_token,
                    "client_id": client_id,
                    "resource": RESOURCE_URL,
                },
            )
        except HTTPFailure as error:
            raise AuthenticationError(
                f"Read AI token refresh failed with HTTP {error.status}; run `readai auth`"
            ) from None
        refreshed = updated_credentials(credentials, response)
        self._save_rotated(refreshed)
        return refreshed

    def _save_rotated(self, credentials: dict[str, Any]) -> None:
        for attempt in range(3):
            try:
                self.store.save(credentials)
                return
            except AuthenticationError:
                if attempt < 2:
                    time.sleep(0.25 * (attempt + 1))
        raise AuthenticationError(
            "the rotated Read AI token could not be saved; run `readai auth` immediately"
        )

    def _access_token(self, credentials: dict[str, Any]) -> tuple[str, dict[str, Any]]:
        if credentials.get("expires_at", 0) <= time.time() + 60:
            credentials = self._refresh(credentials)
        access_token = credentials.get("access_token")
        if not isinstance(access_token, str):
            raise AuthenticationError("Read AI login is incomplete; run `readai auth`")
        return access_token, credentials

    def _get(self, path: str, query: list[tuple[str, str]]) -> dict[str, Any]:
        credentials = self.store.load()
        access_token, credentials = self._access_token(credentials)
        url = f"{API_BASE}{path}"
        if query:
            url = f"{url}?{urllib.parse.urlencode(query)}"

        for attempt in range(2):
            try:
                return self.http.request(
                    "GET", url, headers={"Authorization": f"Bearer {access_token}"}
                )
            except HTTPFailure as error:
                if error.status == 401 and attempt == 0:
                    credentials = self._refresh(credentials)
                    access_token = str(credentials["access_token"])
                    continue
                if error.status == 429 and attempt == 0:
                    try:
                        delay = min(30, max(1, int(error.retry_after or "1")))
                    except ValueError:
                        delay = 1
                    time.sleep(delay)
                    continue
                raise
        raise ReadAIError("Read AI request retry failed")

    def meetings(
        self, *, since_ms: int | None, until_ms: int | None, limit: int
    ) -> dict[str, Any]:
        meetings: list[dict[str, Any]] = []
        cursor = None
        truncated = False
        while len(meetings) < limit:
            query = [("limit", str(min(10, limit - len(meetings))))]
            if since_ms is not None:
                query.append(("start_time_ms.gte", str(since_ms)))
            if until_ms is not None:
                query.append(("start_time_ms.lt", str(until_ms)))
            if cursor is not None:
                query.append(("cursor", cursor))
            response = self._get("/v1/meetings", query)
            page = response.get("data")
            if not isinstance(page, list):
                raise ReadAIError("Read AI returned an invalid meeting list")
            meetings.extend(item for item in page if isinstance(item, dict))
            if not response.get("has_more") or not page:
                break
            if len(meetings) >= limit:
                truncated = True
                break
            last_id = page[-1].get("id") if isinstance(page[-1], dict) else None
            if not isinstance(last_id, str) or last_id == cursor:
                raise ReadAIError("Read AI returned an invalid pagination cursor")
            cursor = last_id
        return {"meetings": meetings[:limit], "truncated": truncated}

    def transcript(self, meeting_id: str) -> dict[str, Any]:
        encoded_id = urllib.parse.quote(meeting_id, safe="")
        meeting = self._get(f"/v1/meetings/{encoded_id}", [("expand[]", "transcript")])
        transcript = meeting.get("transcript")
        if not isinstance(transcript, dict) or not transcript:
            raise TranscriptUnavailable(
                f"meeting {meeting_id} has no transcript available"
            )
        return {
            "id": meeting.get("id", meeting_id),
            "title": meeting.get("title"),
            "transcript": normalize_transcript(transcript),
        }


def normalize_transcript(transcript: dict[str, Any]) -> dict[str, Any]:
    normalized = dict(transcript)
    turns = transcript.get("turns")
    if not isinstance(turns, list):
        raise ReadAIError("Read AI returned a transcript without turns")
    timestamped: list[tuple[int, int, dict[str, Any]]] = []
    for index, turn in enumerate(turns):
        if (
            not isinstance(turn, dict)
            or not isinstance(turn.get("text"), str)
            or not turn["text"].strip()
        ):
            raise ReadAIError("Read AI returned a malformed transcript turn")
        speaker = turn.get("speaker")
        if (
            not isinstance(speaker, dict)
            or not isinstance(speaker.get("name"), str)
            or not speaker["name"].strip()
        ):
            raise ReadAIError("Read AI returned a transcript turn without a speaker")
        start_time = turn.get("start_time_ms")
        end_time = turn.get("end_time_ms")
        if type(start_time) is not int or type(end_time) is not int:
            raise ReadAIError("Read AI returned a transcript turn without timestamps")
        if end_time < start_time:
            raise ReadAIError(
                "Read AI returned a transcript turn with invalid timestamps"
            )
        timestamped.append((start_time, index, turn))
    timestamped.sort(key=lambda item: (item[0], item[1]))
    normalized["turns"] = [item[2] for item in timestamped]
    return normalized


def parse_meeting_id(value: str) -> str:
    candidate = value.strip()
    if "://" in candidate:
        parsed_url = urllib.parse.urlparse(candidate)
        if (
            parsed_url.scheme != "https"
            or parsed_url.hostname not in ALLOWED_MEETING_HOSTS
        ):
            raise argparse.ArgumentTypeError("meeting URL must be an HTTPS Read AI URL")
        candidate = urllib.parse.unquote(parsed_url.path.rstrip("/").rsplit("/", 1)[-1])
    if not ULID_PATTERN.fullmatch(candidate):
        raise argparse.ArgumentTypeError(
            "meeting must be a 26-character Read AI ULID or URL"
        )
    return candidate.upper()


def local_timezone() -> dt.tzinfo:
    timezone_name = os.environ.get("TZ")
    if not timezone_name:
        try:
            resolved = str(Path("/etc/localtime").resolve())
            timezone_name = resolved.split("/zoneinfo/", 1)[1]
        except (IndexError, OSError):
            timezone_name = None
    if timezone_name:
        try:
            return ZoneInfo(timezone_name)
        except ZoneInfoNotFoundError:
            pass
    return dt.datetime.now().astimezone().tzinfo or dt.timezone.utc


def parse_time_boundary(
    value: str, *, upper: bool, timezone: dt.tzinfo | None = None
) -> int:
    timezone = timezone or local_timezone()
    try:
        if re.fullmatch(r"\d{4}-\d{2}-\d{2}", value):
            boundary_date = dt.date.fromisoformat(value)
            if upper:
                boundary_date += dt.timedelta(days=1)
            parsed = dt.datetime.combine(boundary_date, dt.time.min, tzinfo=timezone)
        else:
            parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
            if parsed.tzinfo is None:
                parsed = parsed.replace(tzinfo=timezone)
        return int(parsed.timestamp() * 1000)
    except ValueError:
        raise argparse.ArgumentTypeError(
            "time must be YYYY-MM-DD or an ISO 8601 datetime"
        ) from None


def register_client(http: HTTPClient, redirect_uri: str) -> dict[str, Any]:
    try:
        response = http.request(
            "POST",
            REGISTER_URL,
            json_body={
                "client_name": "lelouvincx readai CLI",
                "redirect_uris": [redirect_uri],
                "grant_types": ["authorization_code", "refresh_token"],
                "response_types": ["code"],
                "scope": SCOPES,
                "token_endpoint_auth_method": "none",
            },
        )
    except HTTPFailure as error:
        raise AuthenticationError(
            f"Read AI client registration failed with HTTP {error.status}"
        ) from None
    client_id = response.get("client_id")
    if not isinstance(client_id, str):
        raise AuthenticationError("Read AI returned an incomplete client registration")
    validate_scopes(response.get("scope"))
    return {"version": 1, "client_id": client_id, "redirect_uri": redirect_uri}


class OAuthCallbackHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path != "/oauth/callback":
            self.send_error(404)
            return
        self.server.authorization_result = urllib.parse.parse_qs(parsed.query)  # type: ignore[attr-defined]
        body = b"Read AI authentication complete. You can close this window."
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format: str, *args: Any) -> None:
        pass


@contextlib.contextmanager
def oauth_callback_server() -> Iterator[tuple[http.server.HTTPServer, str]]:
    try:
        server = http.server.HTTPServer(("127.0.0.1", 0), OAuthCallbackHandler)
    except OSError as error:
        raise AuthenticationError(
            f"cannot open the local OAuth callback: {error}"
        ) from None
    server.timeout = 300
    server.authorization_result = None  # type: ignore[attr-defined]
    redirect_uri = f"http://127.0.0.1:{server.server_port}/oauth/callback"
    try:
        yield server, redirect_uri
    finally:
        server.server_close()


def pkce_challenge(verifier: str) -> str:
    digest = hashlib.sha256(verifier.encode()).digest()
    return base64_url(digest)


def base64_url(value: bytes) -> str:
    return base64.urlsafe_b64encode(value).decode().rstrip("=")


def authorization_url(
    *, client_id: str, redirect_uri: str, state: str, challenge: str
) -> str:
    query = urllib.parse.urlencode(
        {
            "response_type": "code",
            "client_id": client_id,
            "redirect_uri": redirect_uri,
            "scope": SCOPES,
            "state": state,
            "code_challenge": challenge,
            "code_challenge_method": "S256",
            "resource": RESOURCE_URL,
        }
    )
    return f"{AUTHORIZATION_URL}?{query}"


def wait_for_authorization(
    server: http.server.HTTPServer, url: str, expected_state: str
) -> str:
    try:
        subprocess.run(["open", url], check=True, stdout=subprocess.DEVNULL)
    except (FileNotFoundError, subprocess.CalledProcessError):
        raise AuthenticationError(
            "cannot open the Read AI authorization page"
        ) from None
    print("Complete Read AI authorization in your browser.")
    server.handle_request()
    result = getattr(server, "authorization_result", None)
    if not isinstance(result, dict):
        raise AuthenticationError("Read AI authorization timed out")
    if result.get("state") != [expected_state]:
        raise AuthenticationError("Read AI returned an invalid OAuth state")
    if "error" in result:
        description = result.get("error_description", result["error"])[0]
        raise AuthenticationError(f"Read AI authorization failed: {description}")
    codes = result.get("code")
    if not isinstance(codes, list) or len(codes) != 1 or not codes[0]:
        raise AuthenticationError("Read AI did not return an authorization code")
    return codes[0]


def authenticate(store: OnePasswordStore, http: HTTPClient) -> None:
    verifier = secrets.token_urlsafe(64)
    state = secrets.token_urlsafe(32)
    with oauth_callback_server() as (server, redirect_uri):
        credentials = register_client(http, redirect_uri)
        client_id = ReadAIClient._require_client(credentials)
        code = wait_for_authorization(
            server,
            authorization_url(
                client_id=client_id,
                redirect_uri=redirect_uri,
                state=state,
                challenge=pkce_challenge(verifier),
            ),
            state,
        )
        try:
            response = http.request(
                "POST",
                TOKEN_URL,
                form={
                    "grant_type": "authorization_code",
                    "code": code,
                    "redirect_uri": redirect_uri,
                    "code_verifier": verifier,
                    "client_id": client_id,
                    "resource": RESOURCE_URL,
                },
            )
        except HTTPFailure as error:
            raise AuthenticationError(
                f"Read AI login failed with HTTP {error.status}; run `readai auth` again"
            ) from None
    store.save(updated_credentials(credentials, response))
    print("Read AI authentication saved in 1Password.")


def positive_limit(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError("limit must be an integer") from None
    if parsed < 1 or parsed > 100:
        raise argparse.ArgumentTypeError("limit must be between 1 and 100")
    return parsed


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="readai", description="Retrieve speaker-attributed Read AI transcripts"
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("auth", help="authenticate with Read AI")
    meetings_parser = subparsers.add_parser("meetings", help="list accessible meetings")
    meetings_parser.add_argument("--since")
    meetings_parser.add_argument("--until")
    meetings_parser.add_argument("--limit", type=positive_limit, default=10)
    transcript_parser = subparsers.add_parser(
        "transcript", help="retrieve one transcript"
    )
    transcript_parser.add_argument("meeting", type=parse_meeting_id)
    return parser


def main(arguments: list[str] | None = None) -> int:
    parser = build_parser()
    options = parser.parse_args(arguments)
    store = OnePasswordStore()
    http = HTTPClient()
    try:
        with credential_lock():
            if options.command == "auth":
                authenticate(store, http)
                return 0
            client = ReadAIClient(store, http)
            if options.command == "meetings":
                since_ms = (
                    parse_time_boundary(options.since, upper=False)
                    if options.since
                    else None
                )
                until_ms = (
                    parse_time_boundary(options.until, upper=True)
                    if options.until
                    else None
                )
                if (
                    since_ms is not None
                    and until_ms is not None
                    and since_ms >= until_ms
                ):
                    parser.error("--since must be earlier than --until")
                payload: Any = client.meetings(
                    since_ms=since_ms, until_ms=until_ms, limit=options.limit
                )
            else:
                payload = client.transcript(options.meeting)
        json.dump(payload, sys.stdout, ensure_ascii=False, indent=2)
        sys.stdout.write("\n")
        return 0
    except TranscriptUnavailable as error:
        print(f"error: {error}", file=sys.stderr)
        return 4
    except AuthenticationError as error:
        print(f"error: {error}", file=sys.stderr)
        return 3
    except ReadAIError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("error: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
