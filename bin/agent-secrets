#!/usr/bin/env python3
"""Run approved local commands with 1Password-backed capability bundles."""

import argparse
import json
import os
import re
import shutil
import stat
import subprocess
import sys
from pathlib import Path


MANIFEST_VERSION = 1
VAULT = "Agent Secrets"
INTERACTIVE_ACCOUNT = "my.1password.com"
NAME_PATTERN = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
VARIABLE_PATTERN = re.compile(r"^[A-Z][A-Z0-9_]*$")
SECRET_NAME_PARTS = ("TOKEN", "KEY", "SECRET", "PASSWORD", "CREDENTIAL", "AUTH")
PROCESS_CONTROL_NAMES = {
    "BASH_ENV",
    "CDPATH",
    "ENV",
    "FPATH",
    "GIT_ASKPASS",
    "GIT_CONFIG_COUNT",
    "GIT_CONFIG_PARAMETERS",
    "GIT_EXEC_PATH",
    "NODE_OPTIONS",
    "NODE_PATH",
    "PERL5LIB",
    "PERL5OPT",
    "PYTHONHOME",
    "PYTHONPATH",
    "RUBYOPT",
    "SSH_ASKPASS",
}
PROCESS_CONTROL_PREFIXES = (
    "DYLD_",
    "GIT_CONFIG_KEY_",
    "GIT_CONFIG_VALUE_",
    "LD_",
)
FORBIDDEN_BUNDLE_VARIABLES = PROCESS_CONTROL_NAMES | {
    "AGENT_SECRET_AUTH",
    "OP_SERVICE_ACCOUNT_TOKEN",
    "PATH",
}
ROOT_KEYS = {
    "version",
    "command_classes",
    "bundles",
}
CLASS_KEYS = {"executablePaths"}
BUNDLE_KEYS = {
    "audience",
    "owner",
    "variables",
    "compatibleBundles",
    "allowedCommandClasses",
}


class AgentSecretsError(Exception):
    """A safe user-facing failure."""


class PolicyError(AgentSecretsError):
    """A policy failure that must not trigger authentication fallback."""


class LocalStateError(AgentSecretsError):
    """An unsafe or invalid local file failure."""


class OpOperationalError(AgentSecretsError):
    """An operational 1Password CLI failure eligible for one-way fallback."""


def _reject_duplicate_keys(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise PolicyError(f"manifest contains duplicate JSON key: {key}")
        result[key] = value
    return result


def _exact_keys(value, expected, location):
    if not isinstance(value, dict):
        raise PolicyError(f"{location} must be an object")
    missing = sorted(expected - set(value))
    unknown = sorted(set(value) - expected)
    if missing:
        raise PolicyError(f"{location} is missing fields: {', '.join(missing)}")
    if unknown:
        raise PolicyError(f"{location} contains unknown fields: {', '.join(unknown)}")


def _name(value, location):
    if not isinstance(value, str) or not NAME_PATTERN.fullmatch(value):
        raise PolicyError(f"{location} has an invalid name")


def _string_list(value, location, pattern, allow_empty):
    if not isinstance(value, list) or (not allow_empty and not value):
        qualifier = "a list" if allow_empty else "a non-empty list"
        raise PolicyError(f"{location} must be {qualifier}")
    if any(not isinstance(item, str) or not pattern.fullmatch(item) for item in value):
        raise PolicyError(f"{location} contains an invalid value")
    if len(value) != len(set(value)):
        raise PolicyError(f"{location} contains duplicate values")
    return value


def _forbidden_process_variable(name):
    return name in PROCESS_CONTROL_NAMES or name.startswith(PROCESS_CONTROL_PREFIXES)


def _forbidden_bundle_variable(name):
    return name in FORBIDDEN_BUNDLE_VARIABLES or name.startswith(PROCESS_CONTROL_PREFIXES)


def load_manifest(path):
    try:
        manifest = json.loads(path.read_text(), object_pairs_hook=_reject_duplicate_keys)
    except PolicyError:
        raise
    except (OSError, json.JSONDecodeError) as error:
        raise PolicyError(f"cannot read capability manifest: {error}") from error

    _exact_keys(manifest, ROOT_KEYS, "manifest")
    if manifest["version"] != MANIFEST_VERSION:
        raise PolicyError("manifest has an unsupported version")

    command_classes = manifest["command_classes"]
    bundles = manifest["bundles"]
    if not isinstance(command_classes, dict) or not command_classes:
        raise PolicyError("manifest command_classes must be a non-empty object")
    if not isinstance(bundles, dict) or not bundles:
        raise PolicyError("manifest bundles must be a non-empty object")

    executable_owners = {}
    for class_name, command_class in command_classes.items():
        _name(class_name, "command class")
        _exact_keys(command_class, CLASS_KEYS, f"command class {class_name}")
        paths = command_class["executablePaths"]
        if not isinstance(paths, list) or not paths:
            raise PolicyError(f"command class {class_name} needs executable paths")
        if len(paths) != len(set(paths)):
            raise PolicyError(f"command class {class_name} contains duplicate executable paths")
        for executable_path in paths:
            if not isinstance(executable_path, str) or not executable_path.startswith("/"):
                raise PolicyError(f"command class {class_name} has a non-absolute executable path")
            if os.path.normpath(executable_path) != executable_path:
                raise PolicyError(f"command class {class_name} has an unnormalized executable path")
            if "op://" in executable_path.lower():
                raise PolicyError("1Password references are forbidden in the manifest")
            previous = executable_owners.get(executable_path)
            if previous is not None and previous != class_name:
                raise PolicyError("an executable path belongs to more than one command class")
            executable_owners[executable_path] = class_name

    for bundle_name, bundle in bundles.items():
        _name(bundle_name, "bundle")
        _exact_keys(bundle, BUNDLE_KEYS, f"bundle {bundle_name}")
        if bundle["audience"] not in {"agent", "publisher"}:
            raise PolicyError(f"bundle {bundle_name} has an invalid audience")
        owner = bundle["owner"]
        if (
            not isinstance(owner, str)
            or not re.fullmatch(r"[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?", owner)
        ):
            raise PolicyError(f"bundle {bundle_name} has an invalid owner")
        variables = _string_list(
            bundle["variables"], f"bundle {bundle_name} variables", VARIABLE_PATTERN, False
        )
        compatible = _string_list(
            bundle["compatibleBundles"],
            f"bundle {bundle_name} compatibleBundles",
            NAME_PATTERN,
            True,
        )
        allowed_classes = _string_list(
            bundle["allowedCommandClasses"],
            f"bundle {bundle_name} allowedCommandClasses",
            NAME_PATTERN,
            False,
        )
        for variable in variables:
            if _forbidden_bundle_variable(variable):
                raise PolicyError(f"bundle {bundle_name} contains process-control variable {variable}")
        for class_name in allowed_classes:
            if class_name not in command_classes:
                raise PolicyError(f"bundle {bundle_name} names an unknown command class")
        for other_name in compatible:
            if other_name == bundle_name:
                raise PolicyError(f"bundle {bundle_name} cannot be compatible with itself")
            if other_name not in bundles:
                raise PolicyError(f"bundle {bundle_name} names an unknown compatible bundle")

    for bundle_name, bundle in bundles.items():
        for other_name in bundle["compatibleBundles"]:
            other = bundles[other_name]
            if bundle_name not in other["compatibleBundles"]:
                raise PolicyError("bundle compatibility must be symmetric")
            if bundle["audience"] != other["audience"]:
                raise PolicyError("compatible bundles must have one audience")
    return manifest


def authentication_mode(environment):
    mode = environment.get("AGENT_SECRET_AUTH", "interactive")
    if mode not in {"interactive", "service-account"}:
        raise PolicyError("AGENT_SECRET_AUTH must be interactive or service-account")
    return mode


def _secure_directory(path, label):
    try:
        metadata = path.lstat()
    except OSError as error:
        raise LocalStateError(f"{label} is unavailable: {error.strerror}") from error
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        raise LocalStateError(f"{label} must be a real directory")
    if metadata.st_uid != os.getuid():
        raise LocalStateError(f"{label} must be owned by the current user")
    if stat.S_IMODE(metadata.st_mode) != 0o700:
        raise LocalStateError(f"{label} permissions must be 0700")


def _secure_file(path, label):
    try:
        metadata = path.lstat()
    except OSError as error:
        raise LocalStateError(f"{label} is unavailable: {error.strerror}") from error
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        raise LocalStateError(f"{label} must be a regular file, not a symbolic link")
    if metadata.st_uid != os.getuid():
        raise LocalStateError(f"{label} must be owned by the current user")
    if stat.S_IMODE(metadata.st_mode) != 0o600:
        raise LocalStateError(f"{label} permissions must be 0600")


def bundle_directory(home):
    return home / ".credentials" / "agent-secrets"


def bootstrap_file(home):
    return home / ".local" / "share" / "agent-secrets" / "op-service-account-token"


def manifest_file(home, environment):
    configured = environment.get("AMP_CONFIG_DIR")
    if configured:
        root = Path(configured).expanduser()
        if not root.is_absolute():
            raise PolicyError("AMP_CONFIG_DIR must be absolute")
    else:
        root = home / ".config" / "amp"
    return root / "agent-secrets" / "bundles.json"


def parse_bundle_file(path, bundle_name, expected_variables, vault=VAULT):
    _secure_file(path, f"bundle file {bundle_name}")
    try:
        lines = path.read_text().splitlines()
    except OSError as error:
        raise LocalStateError(f"cannot read bundle file {bundle_name}: {error.strerror}") from error

    assignments = {}
    prefix = f"op://{vault}/"
    for line_number, line in enumerate(lines, 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        match = re.fullmatch(r"([A-Z][A-Z0-9_]*)=(.+)", line)
        if not match:
            raise LocalStateError(f"bundle {bundle_name} has malformed line {line_number}")
        variable, reference = match.groups()
        if variable in assignments:
            raise LocalStateError(f"bundle {bundle_name} repeats variable {variable}")
        if variable not in expected_variables:
            raise LocalStateError(f"bundle {bundle_name} contains unknown variable {variable}")
        if not reference.startswith(prefix):
            raise LocalStateError(f"bundle {bundle_name} variable {variable} is not in {vault}")
        if any(character in reference for character in ('"', "'", "$", "`", "\\", "?", "#")):
            raise LocalStateError(f"bundle {bundle_name} variable {variable} has unsafe syntax")
        reference_parts = reference[len(prefix) :].split("/")
        if len(reference_parts) < 2 or any(not part for part in reference_parts):
            raise LocalStateError(f"bundle {bundle_name} variable {variable} has an invalid reference")
        assignments[variable] = reference

    missing = sorted(set(expected_variables) - set(assignments))
    if missing:
        raise LocalStateError(f"bundle {bundle_name} is missing variables: {', '.join(missing)}")
    return assignments


def load_bundle_references(home, manifest, selected_names, all_bundles=False):
    directory = bundle_directory(home)
    _secure_directory(directory, "bundle directory")
    names = sorted(manifest["bundles"]) if all_bundles else selected_names
    if all_bundles:
        expected_files = {f"{name}.env" for name in manifest["bundles"]}
        try:
            actual_files = {path.name for path in directory.iterdir() if path.name.endswith(".env")}
        except OSError as error:
            raise LocalStateError(f"cannot inspect bundle directory: {error.strerror}") from error
        unknown_files = sorted(actual_files - expected_files)
        if unknown_files:
            raise LocalStateError(f"bundle directory contains unknown files: {', '.join(unknown_files)}")

    references = {}
    status_names = []
    for bundle_name in names:
        bundle = manifest["bundles"][bundle_name]
        assignments = parse_bundle_file(
            directory / f"{bundle_name}.env", bundle_name, bundle["variables"]
        )
        for variable, reference in assignments.items():
            reference_key = f"{bundle_name}.{variable}" if all_bundles else variable
            if reference_key in references and references[reference_key] != reference:
                raise PolicyError(f"selected bundles assign different references to {variable}")
            references[reference_key] = reference
            status_names.append((bundle_name, variable))
    return references, status_names


def validate_bundle_selection(manifest, selected_names):
    if not selected_names:
        raise PolicyError("at least one bundle is required")
    if len(selected_names) != len(set(selected_names)):
        raise PolicyError("a bundle may be selected only once")
    for name in selected_names:
        if name not in manifest["bundles"]:
            raise PolicyError(f"unknown bundle: {name}")
    for index, name in enumerate(selected_names):
        bundle = manifest["bundles"][name]
        for other_name in selected_names[index + 1 :]:
            other = manifest["bundles"][other_name]
            if bundle["audience"] != other["audience"]:
                raise PolicyError("selected bundles mix agent and publisher audiences")
            if (
                other_name not in bundle["compatibleBundles"]
                or name not in other["compatibleBundles"]
            ):
                raise PolicyError(f"selected bundles are incompatible: {name}, {other_name}")


def resolve_command_class(manifest, requested_path):
    requested = Path(requested_path)
    if not requested.is_absolute():
        raise PolicyError("child command must use an absolute path")
    try:
        requested_resolved = requested.resolve(strict=True)
    except OSError as error:
        raise PolicyError("child command does not exist") from error
    if not requested_resolved.is_file() or not os.access(requested, os.X_OK):
        raise PolicyError("child command is not an executable file")

    resolved_classes = {}
    for class_name, command_class in manifest["command_classes"].items():
        for registered_path in command_class["executablePaths"]:
            path = Path(registered_path)
            try:
                resolved = path.resolve(strict=True)
            except OSError as error:
                raise PolicyError(f"registered command for {class_name} does not exist") from error
            if not resolved.is_file() or not os.access(path, os.X_OK):
                raise PolicyError(f"registered command for {class_name} is not executable")
            previous = resolved_classes.get(resolved)
            if previous is not None and previous != class_name:
                raise PolicyError("registered command paths resolve to more than one class")
            resolved_classes[resolved] = class_name
    command_class = resolved_classes.get(requested_resolved)
    if command_class is None:
        raise PolicyError("child command does not match a registered command class")
    return command_class


def enforce_command_class(manifest, selected_names, command_class):
    for bundle_name in selected_names:
        if command_class not in manifest["bundles"][bundle_name]["allowedCommandClasses"]:
            raise PolicyError(
                f"command class {command_class} is not allowed for bundle {bundle_name}"
            )


def _remove_from_environment(name):
    upper = name.upper()
    return (
        any(part in upper for part in SECRET_NAME_PARTS)
        or _forbidden_process_variable(upper)
        or upper == "OP_SERVICE_ACCOUNT_TOKEN"
    )


def sanitized_environment(environment):
    return {name: value for name, value in environment.items() if not _remove_from_environment(name)}


def child_environment(environment, resolved_values):
    child = sanitized_environment(environment)
    child.update(resolved_values)
    return child


def load_bootstrap_token(home):
    path = bootstrap_file(home)
    _secure_directory(path.parent, "service-account bootstrap directory")
    _secure_file(path, "service-account bootstrap file")
    try:
        raw = path.read_text()
    except OSError as error:
        raise LocalStateError(f"cannot read service-account bootstrap file: {error.strerror}") from error
    token = raw.rstrip("\n")
    if not token or "\n" in token or "\r" in token:
        raise LocalStateError("service-account bootstrap file must contain one non-empty token")
    if "=" in token:
        raise LocalStateError("service-account bootstrap file must not contain an assignment")
    return token


def op_executable(environment):
    executable = shutil.which("op", path=environment.get("PATH"))
    if executable is None:
        raise OpOperationalError("1Password CLI is unavailable")
    return executable


def run_op(arguments, environment, stage):
    executable = op_executable(environment)
    try:
        result = subprocess.run(
            [executable, *arguments],
            check=False,
            capture_output=True,
            text=True,
            env=environment,
        )
    except OSError as error:
        raise OpOperationalError(f"1Password command could not start during {stage}") from error
    if result.returncode != 0:
        raise OpOperationalError(f"1Password command failed during {stage}")
    return result.stdout


def interactive_values(references, environment):
    op_environment = sanitized_environment(environment)
    account = INTERACTIVE_ACCOUNT
    account_output = run_op(
        ["account", "get", "--account", account, "--format", "json"],
        op_environment,
        "interactive account validation",
    )
    try:
        if not isinstance(json.loads(account_output), dict):
            raise ValueError
    except (json.JSONDecodeError, ValueError) as error:
        raise OpOperationalError("1Password returned invalid interactive account data") from error

    values = {}
    for reference in dict.fromkeys(references.values()):
        value = run_op(
            ["read", reference, "--account", account],
            op_environment,
            "interactive secret resolution",
        ).rstrip("\n")
        if not value or "\x00" in value:
            raise OpOperationalError("1Password returned an unusable resolved value")
        values[reference] = value
    return values


def service_account_values(references, environment, home):
    token = load_bootstrap_token(home)
    op_environment = sanitized_environment(environment)
    op_environment["OP_SERVICE_ACCOUNT_TOKEN"] = token
    try:
        vault_output = run_op(
            ["vault", "list", "--format", "json"],
            op_environment,
            "service-account vault validation",
        )
        try:
            vaults = json.loads(vault_output)
            names = [vault["name"] for vault in vaults]
            if not isinstance(vaults, list) or any(not isinstance(name, str) for name in names):
                raise ValueError
        except (json.JSONDecodeError, KeyError, TypeError, ValueError) as error:
            raise OpOperationalError("1Password returned invalid service-account vault data") from error
        if names != [VAULT]:
            raise PolicyError(f"service account must access exactly {VAULT}")

        values = {}
        for reference in dict.fromkeys(references.values()):
            value = run_op(
                ["read", reference],
                op_environment,
                "service-account secret resolution",
            ).rstrip("\n")
            if not value or "\x00" in value:
                raise OpOperationalError("1Password returned an unusable resolved value")
            values[reference] = value
        return values
    finally:
        op_environment.pop("OP_SERVICE_ACCOUNT_TOKEN", None)
        del token


def resolve_values(references, mode, environment, home):
    if mode == "interactive":
        by_reference = interactive_values(references, environment)
    else:
        try:
            by_reference = service_account_values(references, environment, home)
        except OpOperationalError:
            print(
                "agent-secrets: service-account operation failed; "
                "retrying the complete operation interactively",
                file=sys.stderr,
            )
            by_reference = interactive_values(references, environment)
    resolved = {variable: by_reference[reference] for variable, reference in references.items()}
    by_reference.clear()
    return resolved


def run_probe(environment):
    code = (
        "import os,sys; "
        "sys.exit(1 if 'OP_SERVICE_ACCOUNT_TOKEN' in os.environ "
        "or 'AGENT_SECRET_AUTH' in os.environ else 0)"
    )
    try:
        result = subprocess.run(
            [sys.executable, "-c", code],
            check=False,
            capture_output=True,
            env=sanitized_environment(environment),
        )
    except OSError as error:
        raise AgentSecretsError("child-environment probe could not start") from error
    if result.returncode != 0:
        raise AgentSecretsError("child environment inherited an authentication selector or token")


def run_command(args, environment, home, manifest):
    command = list(args.command)
    if command and command[0] == "--":
        command.pop(0)
    if not command:
        raise PolicyError("run requires -- followed by an absolute child command")
    selected_names = args.bundle
    validate_bundle_selection(manifest, selected_names)
    command_class = resolve_command_class(manifest, command[0])
    enforce_command_class(manifest, selected_names, command_class)
    references, _ = load_bundle_references(home, manifest, selected_names)
    values = resolve_values(references, authentication_mode(environment), environment, home)
    references.clear()
    environment_for_child = child_environment(environment, values)
    try:
        result = subprocess.run(command, check=False, env=environment_for_child)
    except OSError as error:
        raise AgentSecretsError("approved child command could not start") from error
    finally:
        environment_for_child.clear()
        values.clear()
    return result.returncode if result.returncode >= 0 else 128 - result.returncode


def doctor(environment, home, manifest):
    references, status_names = load_bundle_references(
        home, manifest, sorted(manifest["bundles"]), all_bundles=True
    )
    values = resolve_values(references, authentication_mode(environment), environment, home)
    values.clear()
    references.clear()
    run_probe(environment)
    for bundle_name, variable in status_names:
        print(f"{bundle_name}.{variable}: ok")
    print("child-environment probe: ok")
    return 0


def parser():
    argument_parser = argparse.ArgumentParser(prog="agent-secrets")
    subcommands = argument_parser.add_subparsers(dest="subcommand", required=True)
    run_parser = subcommands.add_parser("run", help="run one registered command")
    run_parser.add_argument(
        "--bundle", action="append", required=True, help="capability bundle name"
    )
    run_parser.add_argument("command", nargs=argparse.REMAINDER)
    subcommands.add_parser("doctor", help="validate policy, local files and authentication")
    return argument_parser


def main(argv=None, environment=None):
    environment = dict(os.environ if environment is None else environment)
    try:
        raw_arguments = list(sys.argv[1:] if argv is None else argv)
        if raw_arguments[:1] == ["run"] and "--" not in raw_arguments:
            raise PolicyError("run requires -- before the absolute child command")
        args = parser().parse_args(raw_arguments)
        mode = authentication_mode(environment)
        del mode
        home = Path(environment.get("HOME", str(Path.home()))).expanduser()
        if not home.is_absolute():
            raise PolicyError("HOME must be absolute")
        manifest = load_manifest(manifest_file(home, environment))
        if args.subcommand == "run":
            return run_command(args, environment, home, manifest)
        return doctor(environment, home, manifest)
    except AgentSecretsError as error:
        print(f"agent-secrets: error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
