#!/usr/bin/env bash
set -euo pipefail

script="${BASH_SOURCE[0]}"
if [ -L "$script" ]; then
  target="$(readlink "$script")"
  if [[ "$target" = /* ]]; then
    script="$target"
  else
    script="$(dirname "$script")/$target"
  fi
fi
repo_root="$(cd "$(dirname "$script")/.." && pwd)"
install_dir="${AGENT_BROWSER_CUSTOM_INSTALL_DIR:-$HOME/.local/libexec/agent-browser-rfc0011}"
binary="$install_dir/agent-browser"
receipt="$install_dir/build-input.sha256"
fingerprint="$repo_root/amp/agent-browser-custom/fingerprint"
source "$repo_root/amp/agent-browser-custom/lib.sh"

if [ ! -x "$binary" ] || [ ! -f "$receipt" ]; then
  echo "agent-browser: RFC-0011 custom build is not installed; run amp/agent-browser-custom/build" >&2
  exit 1
fi
expected="$($fingerprint)"
actual="$(tr -d '[:space:]' <"$receipt")"
if [ "$actual" != "$expected" ]; then
  echo "agent-browser: RFC-0011 custom build is stale; run amp/agent-browser-custom/build" >&2
  exit 1
fi
agent_browser_custom_verify_skill_data "$install_dir" "$repo_root"

export AGENT_BROWSER_SKILLS_DIR="$install_dir/skill-data"
exec "$binary" "$@"
